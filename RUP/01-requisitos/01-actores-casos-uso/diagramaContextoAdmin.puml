@startuml diagramaContextoAdmin

left to right direction
skinparam linetype polyline

state SESION_CERRADA
state SISTEMA_DISPONIBLE

state UNIVERSIDADES_ABIERTO
state UNIVERSIDAD_ABIERTO
state FACULTADES_ABIERTO
state FACULTAD_ABIERTO
state PROGRAMAS_ABIERTO
state PROGRAMA_ABIERTO
state ASIGNATURAS_ABIERTO
state ASIGNATURA_ABIERTO
state METODOLOGIAS_DOCENTES_ABIERTO
state METODOLOGIA_DOCENTE_ABIERTO
state METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO
state RESULTADOS_APRENDIZAJE_ABIERTO
state RESULTADO_APRENDIZAJE_ABIERTO
state PROFESORES_ABIERTO
state PROFESOR_ABIERTO
state SISTEMAS_EVALUACION_ABIERTO
state SISTEMA_EVALUACION_ABIERTO
state MATERIAS_ABIERTO
state MATERIA_ABIERTO
state ASIGNATURA_PROGRAMA_ABIERTO
state CURSOS_ACADEMICOS_ABIERTO
state CURSO_ACADEMICO_ABIERTO
state GUIAS_DEL_PROGRAMA_ABIERTO
state GUIA_ABIERTO
state COPIAS_SEGURIDAD_ABIERTO
state HISTORIAL_CAMBIOS_ABIERTO

[*] --> SESION_CERRADA

SESION_CERRADA --> SISTEMA_DISPONIBLE : iniciarSesion()
' credenciales invalidas: no hay transicion de estado, self-loop explicito
' -- detectado al construir la especificacion de enviarGuiaARevision()
SESION_CERRADA --> SESION_CERRADA : iniciarSesion()
SISTEMA_DISPONIBLE --> SESION_CERRADA : cerrarSesion()

SISTEMA_DISPONIBLE --> UNIVERSIDADES_ABIERTO : abrirUniversidades()
SISTEMA_DISPONIBLE --> ASIGNATURAS_ABIERTO : abrirAsignaturas()
SISTEMA_DISPONIBLE --> METODOLOGIAS_DOCENTES_ABIERTO : abrirMetodologiasDocentes()
SISTEMA_DISPONIBLE --> ACTIVIDADES_FORMATIVAS_ABIERTO : abrirActividadesFormativas()
SISTEMA_DISPONIBLE --> PROFESORES_ABIERTO : abrirProfesores()
SISTEMA_DISPONIBLE --> CURSOS_ACADEMICOS_ABIERTO : abrirCursosAcademicos()
SISTEMA_DISPONIBLE --> COPIAS_SEGURIDAD_ABIERTO : consultarCopiasSeguridad()
SISTEMA_DISPONIBLE --> HISTORIAL_CAMBIOS_ABIERTO : consultarHistorialCambios()

SISTEMA_DISPONIBLE --> SISTEMA_DISPONIBLE : generarGuiasPDF()

' Las seis vueltas a SISTEMA_DISPONIBLE de este fichero usan
' abrirPanelAdministracion() -- antes completarGestion() genérico, corregido
' al planificar Análisis (discussion #47): son listados, no formularios, y el
' destino ya tiene CU propio (ver abrirPanelAdministracion/README.md).
' Universidad -- sin eliminarUniversidad(): única excepción del catálogo
UNIVERSIDADES_ABIERTO --> UNIVERSIDAD_ABIERTO : crearUniversidad()
UNIVERSIDADES_ABIERTO --> UNIVERSIDAD_ABIERTO : abrirUniversidad()
UNIVERSIDAD_ABIERTO --> UNIVERSIDAD_ABIERTO : editarUniversidad()
UNIVERSIDAD_ABIERTO --> UNIVERSIDADES_ABIERTO : abrirUniversidades()
UNIVERSIDADES_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

' Facultad no es catálogo institucional (a diferencia de Asignatura/MetodologiaDocente):
' es composición real de Universidad (Universidad *-- Facultad), se navega desde dentro de ella
UNIVERSIDAD_ABIERTO --> FACULTADES_ABIERTO : abrirFacultades()

FACULTADES_ABIERTO --> FACULTAD_ABIERTO : crearFacultad()
FACULTADES_ABIERTO --> FACULTAD_ABIERTO : abrirFacultad()
FACULTADES_ABIERTO --> FACULTADES_ABIERTO : eliminarFacultad()
FACULTAD_ABIERTO --> FACULTAD_ABIERTO : editarFacultad()
FACULTAD_ABIERTO --> FACULTADES_ABIERTO : abrirFacultades()
FACULTADES_ABIERTO --> UNIVERSIDAD_ABIERTO : abrirUniversidad()

' Programa tampoco es catálogo: composición real de Facultad (Facultad *-d- Programa),
' mismo patrón que Facultad dentro de Universidad
FACULTAD_ABIERTO --> PROGRAMAS_ABIERTO : abrirProgramas()

PROGRAMAS_ABIERTO --> PROGRAMA_ABIERTO : crearPrograma()
PROGRAMAS_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()
PROGRAMAS_ABIERTO --> PROGRAMAS_ABIERTO : eliminarPrograma()
PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : editarPrograma()

' Segunda entrada a definirDirectorPrograma()/quitarDirectorPrograma() (issue #492,
' flujo alternativo del mismo caso de uso ya catalogado sobre PROFESOR_ABIERTO,
' ver mas abajo) -- el Admin tambien puede nombrar/quitar director de Programa
' directamente desde la vista del Programa, sin pasar por el Profesor
PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : definirDirectorPrograma()
PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : quitarDirectorPrograma()

' asociarMetodologiaDocenteAPrograma()/desasociarMetodologiaDocentePrograma():
' catalogo de MetodologiaDocente del Programa (Programa o-- MetodologiaDocente), que
' limita lo que las Materia del programa pueden elegir. Pantalla propia desde el issue #640
' (abrirMetodologiasDocentesPrograma(), CU compartido con DirectorPrograma, igual que
' abrirMaterias()); asociar/desasociar son self-loops sobre esa pantalla.
' METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO es un estado DISTINTO de METODOLOGIAS_DOCENTES_ABIERTO
' (ese es el catalogo institucional global, SISTEMA_DISPONIBLE->METODOLOGIAS_DOCENTES_ABIERTO,
' con su propio CRUD de MetodologiaDocente mas abajo) -- pantallas y rutas distintas
' (MetodologiasDocentesProgramaAdmin.tsx / /admin/programas/:id/metodologias-docentes
' vs. MetodologiasDocentes.tsx / /admin/metodologias-docentes), aunque el nombre se parezca.
' No es el mismo caso que MATERIAS_ABIERTO reutilizado entre diagramaContextoAdmin y
' diagramaContextoDirectorPrograma (ahi SI es la misma pantalla conceptual, actor distinto);
' aqui serian dos pantallas distintas para el MISMO actor Admin.
PROGRAMA_ABIERTO --> METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO : abrirMetodologiasDocentesPrograma()
METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()
METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO --> METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO : asociarMetodologiaDocenteAPrograma()
METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO --> METODOLOGIAS_DOCENTES_PROGRAMA_ABIERTO : desasociarMetodologiaDocentePrograma()

' Resultados de Aprendizaje del Programa (issue #642): capacidad compartida con
' DirectorPrograma (mismo patron que abrirMetodologiasDocentesPrograma(), #640).
' RESULTADOS_APRENDIZAJE_ABIERTO / RESULTADO_APRENDIZAJE_ABIERTO estaban LIBRES en este
' diagrama (grep previo): misma pantalla conceptual que en diagramaContextoDirectorPrograma,
' actor distinto (rutas /admin/programas/:id/resultados-aprendizaje y
' /admin/resultados-aprendizaje/:id).
PROGRAMA_ABIERTO --> RESULTADOS_APRENDIZAJE_ABIERTO : abrirResultadosAprendizaje()
RESULTADOS_APRENDIZAJE_ABIERTO --> RESULTADO_APRENDIZAJE_ABIERTO : crearResultadoAprendizaje()
RESULTADOS_APRENDIZAJE_ABIERTO --> RESULTADO_APRENDIZAJE_ABIERTO : abrirResultadoAprendizaje()
RESULTADOS_APRENDIZAJE_ABIERTO --> RESULTADOS_APRENDIZAJE_ABIERTO : eliminarResultadoAprendizaje()
RESULTADO_APRENDIZAJE_ABIERTO --> RESULTADO_APRENDIZAJE_ABIERTO : editarResultadoAprendizaje()
RESULTADO_APRENDIZAJE_ABIERTO --> RESULTADOS_APRENDIZAJE_ABIERTO : abrirResultadosAprendizaje()
RESULTADOS_APRENDIZAJE_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()

PROGRAMA_ABIERTO --> PROGRAMAS_ABIERTO : abrirProgramas()
PROGRAMAS_ABIERTO --> FACULTAD_ABIERTO : abrirFacultad()

' Materia tampoco es catálogo: composición real de Programa (Programa *-- Materia),
' se navega desde dentro de él -- necesaria pese a ser fina para Admin (nombre):
' otros hijos de Materia (SistemaEvaluacion, pendiente; asociaciones de DirectorPrograma
' mas adelante) sí requieren "una Materia concreta abierta"
PROGRAMA_ABIERTO --> MATERIAS_ABIERTO : abrirMaterias()

MATERIAS_ABIERTO --> MATERIA_ABIERTO : crearMateria()
MATERIAS_ABIERTO --> MATERIA_ABIERTO : abrirMateria()
MATERIAS_ABIERTO --> MATERIAS_ABIERTO : eliminarMateria()
MATERIA_ABIERTO --> MATERIA_ABIERTO : editarMateria()
MATERIA_ABIERTO --> MATERIAS_ABIERTO : abrirMaterias()
MATERIAS_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()

' AsignaturaPrograma: dos entradas (atajo plano desde PROGRAMA_ABIERTO, agrupado por
' materias; y desde la propia MATERIA_ABIERTO) y dos retornos, uno por cada entrada
' (abrirPrograma() y abrirMateria()) -- retoque de Manuel usando el producto (issue
' #252, 2026-09-05): el retorno unico original a PROGRAMA_ABIERTO ("la entrada mas
' usada") resulto incomodo para quien entra desde MATERIA_ABIERTO. Segunda oleada
' del mismo patron que #227/PR#234; DirectorPrograma gano su segundo retorno antes
' (ver diagramaContextoDirectorPrograma.puml).
PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : crearAsignaturaPrograma()
PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : eliminarAsignaturaPrograma()
PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : abrirAsignaturaPrograma()
MATERIA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : abrirAsignaturaPrograma()
' Edicion correctiva (issue #602): paridad con DirectorPrograma, caso de uso compartido.
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : editarAsignaturaPrograma()

' SistemaEvaluacion: mismo patrón que AsignaturaPrograma -- composición real de Materia
' (Materia *-- SistemaEvaluacion), cero reutilización cruzada, se navega desde dentro de ella
MATERIA_ABIERTO --> SISTEMAS_EVALUACION_ABIERTO : abrirSistemasEvaluacion()

' asignar/desasignarProfesorAAsignaturaPrograma(): self-loop de navegacion (el Admin
' no sale de ASIGNATURA_PROGRAMA_ABIERTO), pero con efecto colateral sobre el ciclo de
' vida de la Guia activa (issue #254): si la plantilla cambio de verdad y esa Guia
' esta Aprobada, pasa a EnRevision (+ fila de HistorialCambio, autor centinela) para
' que el DirectorPrograma re-apruebe -- al aprobar, Guia--Profesor se re-deriva de la
' plantilla. Es el segundo trigger Admin de Aprobada->EnRevision (el otro es
' reabrirGuiaPorIncidencia()), no una transicion de navegacion propia.
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : asignarProfesorAAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : desasignarProfesorAsignaturaPrograma()

' issue #599: paridad con DirectorPrograma (vía de corrección excepcional) -- cinco
' self-loops de navegación más, sin efecto sobre el ciclo de vida de la Guia.
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : asociarResultadoAprendizajeAAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : desasociarResultadoAprendizajeAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : asociarMetodologiaDocenteAAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : desasociarMetodologiaDocenteAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> ASIGNATURA_PROGRAMA_ABIERTO : editarActividadesFormativasAsignaturaPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()
ASIGNATURA_PROGRAMA_ABIERTO --> MATERIA_ABIERTO : abrirMateria()

' consultarEstadoGuias() del Admin, DOS propositos sobre el mismo listado:
' (1) issue #6 -- localizar la guia con incidencia para reabrirla; el paso
'     abrirGuia() de ese flujo da hoy 403 al Admin en codigo (deriva
'     pre-existente, issue #265; reabrirGuiaPorIncidencia() nunca se construyo).
' (2) issue #262 -- pantalla propia de Admin ([Estado del curso actual] en
'     ProgramaAdmin) para monitorear el estado de las guias durante la beta.
PROGRAMA_ABIERTO --> GUIAS_DEL_PROGRAMA_ABIERTO : consultarEstadoGuias()
GUIAS_DEL_PROGRAMA_ABIERTO --> GUIA_ABIERTO : abrirGuia()
' previsualizarGuia()/descargarGuiaPDF() desde la LISTA (issue #262): los
' botones de fila de la pantalla de Admin abren pestana / descargan blob, la
' pantalla no cambia -- self-loop de GUIAS_DEL_PROGRAMA_ABIERTO, no de GUIA_ABIERTO
' (el Admin no abre la guia). Actor Profesor/DirectorPrograma/Admin, 404 uniforme
' (discussion #218 P3; Admin alineado en #263/#238).
GUIAS_DEL_PROGRAMA_ABIERTO --> GUIAS_DEL_PROGRAMA_ABIERTO : previsualizarGuia()
GUIAS_DEL_PROGRAMA_ABIERTO --> GUIAS_DEL_PROGRAMA_ABIERTO : descargarGuiaPDF()
' descargarGuiaPDF() desde GUIA_ABIERTO se conserva por el flujo de #6
' (localizar -> abrir -> descargar -> reabrir); #262 lo invoca ademas desde la lista.
GUIA_ABIERTO --> GUIA_ABIERTO : descargarGuiaPDF()
GUIA_ABIERTO --> GUIAS_DEL_PROGRAMA_ABIERTO : reabrirGuiaPorIncidencia()
' abrirPrograma(): mismo patrón que las cuatro vueltas equivalentes de
' diagramaContextoDirectorPrograma.puml -- listado, no formulario, destino ya con
' nombre propio. Corregido al planificar Análisis (discussion #47).
GUIAS_DEL_PROGRAMA_ABIERTO --> PROGRAMA_ABIERTO : abrirPrograma()

ASIGNATURAS_ABIERTO --> ASIGNATURA_ABIERTO : crearAsignatura()
ASIGNATURAS_ABIERTO --> ASIGNATURA_ABIERTO : abrirAsignatura()
ASIGNATURAS_ABIERTO --> ASIGNATURAS_ABIERTO : eliminarAsignatura()
ASIGNATURA_ABIERTO --> ASIGNATURA_ABIERTO : editarAsignatura()
ASIGNATURA_ABIERTO --> ASIGNATURAS_ABIERTO : abrirAsignaturas()
ASIGNATURAS_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

METODOLOGIAS_DOCENTES_ABIERTO --> METODOLOGIA_DOCENTE_ABIERTO : crearMetodologiaDocente()
METODOLOGIAS_DOCENTES_ABIERTO --> METODOLOGIA_DOCENTE_ABIERTO : abrirMetodologiaDocente()
METODOLOGIAS_DOCENTES_ABIERTO --> METODOLOGIAS_DOCENTES_ABIERTO : eliminarMetodologiaDocente()
METODOLOGIA_DOCENTE_ABIERTO --> METODOLOGIA_DOCENTE_ABIERTO : editarMetodologiaDocente()
METODOLOGIA_DOCENTE_ABIERTO --> METODOLOGIAS_DOCENTES_ABIERTO : abrirMetodologiasDocentes()
METODOLOGIAS_DOCENTES_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

' ActividadFormativa (issue #655): catalogo de Universidad con CRUD completo de Admin, mismo
' patron que MetodologiaDocente. Antes era seed-estatico sin pantalla (discussion #227): la
' rejilla de horas por Materia/AsignaturaPrograma (DirectorPrograma) sigue siendo otro CU
' distinto -- estos estados son el CATALOGO global de la Universidad, no esa rejilla.
ACTIVIDADES_FORMATIVAS_ABIERTO --> ACTIVIDAD_FORMATIVA_ABIERTO : crearActividadFormativa()
ACTIVIDADES_FORMATIVAS_ABIERTO --> ACTIVIDAD_FORMATIVA_ABIERTO : abrirActividadFormativa()
ACTIVIDADES_FORMATIVAS_ABIERTO --> ACTIVIDADES_FORMATIVAS_ABIERTO : eliminarActividadFormativa()
ACTIVIDAD_FORMATIVA_ABIERTO --> ACTIVIDAD_FORMATIVA_ABIERTO : editarActividadFormativa()
ACTIVIDAD_FORMATIVA_ABIERTO --> ACTIVIDADES_FORMATIVAS_ABIERTO : abrirActividadesFormativas()
ACTIVIDADES_FORMATIVAS_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

' definirDirectorPrograma()/quitarDirectorPrograma(): rol sobre un Profesor ya abierto, no entidad propia.
' Segunda entrada desde PROGRAMA_ABIERTO anadida en el issue #492 (ver mas arriba) -- mismos dos
' casos de uso, flujo alternativo, sin duplicar ficha de Requisitos
PROFESORES_ABIERTO --> PROFESOR_ABIERTO : crearProfesor()
PROFESORES_ABIERTO --> PROFESOR_ABIERTO : abrirProfesor()
PROFESORES_ABIERTO --> PROFESORES_ABIERTO : eliminarProfesor()
PROFESOR_ABIERTO --> PROFESOR_ABIERTO : editarProfesor()
PROFESOR_ABIERTO --> PROFESOR_ABIERTO : definirDirectorPrograma()
PROFESOR_ABIERTO --> PROFESOR_ABIERTO : quitarDirectorPrograma()
PROFESOR_ABIERTO --> PROFESORES_ABIERTO : abrirProfesores()
PROFESORES_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

SISTEMAS_EVALUACION_ABIERTO --> SISTEMA_EVALUACION_ABIERTO : crearSistemaEvaluacion()
SISTEMAS_EVALUACION_ABIERTO --> SISTEMA_EVALUACION_ABIERTO : abrirSistemaEvaluacion()
SISTEMAS_EVALUACION_ABIERTO --> SISTEMAS_EVALUACION_ABIERTO : eliminarSistemaEvaluacion()
SISTEMA_EVALUACION_ABIERTO --> SISTEMA_EVALUACION_ABIERTO : editarSistemaEvaluacion()
SISTEMA_EVALUACION_ABIERTO --> SISTEMAS_EVALUACION_ABIERTO : abrirSistemasEvaluacion()
SISTEMAS_EVALUACION_ABIERTO --> MATERIA_ABIERTO : abrirMateria()

' activarCursoAcademico(): acción de conjunto sobre el listado, no requiere abrir el curso concreto
' (como eliminarX()) -- <<choice>> interno valida elegibilidad (último, o penúltimo si el
' último no tiene actividad registrada), desactiva automáticamente el otro como efecto colateral.
' Sin desactivarCursoAcademico() suelto: activar siempre implica desactivar el otro, no hace
' falta un "apagar sin encender otro".
' editarCursoAcademico()/activarSemestre(): granularidad de detalle sobre un único curso ya abierto (como editarX())
CURSOS_ACADEMICOS_ABIERTO --> CURSO_ACADEMICO_ABIERTO : crearCursoAcademico()
CURSOS_ACADEMICOS_ABIERTO --> CURSO_ACADEMICO_ABIERTO : abrirCursoAcademico()
CURSOS_ACADEMICOS_ABIERTO --> CURSOS_ACADEMICOS_ABIERTO : activarCursoAcademico()
CURSO_ACADEMICO_ABIERTO --> CURSO_ACADEMICO_ABIERTO : editarCursoAcademico()
CURSO_ACADEMICO_ABIERTO --> CURSO_ACADEMICO_ABIERTO : activarSemestre()
CURSO_ACADEMICO_ABIERTO --> CURSOS_ACADEMICOS_ABIERTO : abrirCursosAcademicos()
CURSOS_ACADEMICOS_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

' consultarCopiasSeguridad() (issue #308): listado de solo lectura del
' manifiesto de backups, sin CRUD -- no hay CopiaSeguridad en modeloDominio.puml,
' es un diagnóstico de infraestructura, no una entidad. Verbo consultar, no
' abrir: mismo criterio que consultarEstadoGuias() (lectura/monitoreo sin
' alta-edición-baja), no el de abrirX()/abrirXs() (reservado a catálogos
' reales del dominio con CRUD). Self-loop de listado: no hay detalle que abrir,
' ninguna fila es una entidad propia sobre la que navegar.
COPIAS_SEGURIDAD_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

' comprobarCopiasSeguridad() (issue #683): comprobación bajo demanda, solo
' lectura y sin estado, de la integridad de cada copia del volumen. Autotransición
' de la pantalla de copias; el resultado vive en pantalla, no cambia de estado.
COPIAS_SEGURIDAD_ABIERTO --> COPIAS_SEGURIDAD_ABIERTO : comprobarCopiasSeguridad()

' consultarHistorialCambios() (issue #392): auditoría de solo lectura sobre
' HistorialCambio -- feed de últimas 50 acciones + índice de autores
' fusionado por email (Profesor+DirectorPrograma de la misma persona, issue
' #401), sin CRUD. Self-loop conceptual: la navegación al detalle de un
' autor concreto vive dentro del mismo CU, no es un estado propio.
HISTORIAL_CAMBIOS_ABIERTO --> SISTEMA_DISPONIBLE : abrirPanelAdministracion()

@enduml
