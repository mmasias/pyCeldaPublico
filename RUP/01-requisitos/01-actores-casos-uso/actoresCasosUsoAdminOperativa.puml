@startuml actoresCasosUsoAdminOperativa

left to right direction

' Vista de Admin, partida de actoresCasosUso.puml -- mismos usecase id, solo
' el subconjunto que usa este actor. El fichero completo (actoresCasosUso.puml)
' se retiró -- el reparto por actor es la fuente de verdad.
'
' Admin sin "Catálogos institucionales" -- ese bloque vive en
' actoresCasosUsoAdminCatalogos.puml.

actor Admin

package "Contenido de asignaturas" {
  usecase asociarResultadoAprendizajeAAsignaturaPrograma as "asociarResultadoAprendizajeAAsignaturaPrograma()"
  usecase desasociarResultadoAprendizajeAsignaturaPrograma as "desasociarResultadoAprendizajeAsignaturaPrograma()"
  usecase asociarMetodologiaDocenteAAsignaturaPrograma as "asociarMetodologiaDocenteAAsignaturaPrograma()"
  usecase desasociarMetodologiaDocenteAsignaturaPrograma as "desasociarMetodologiaDocenteAsignaturaPrograma()"
  usecase editarActividadesFormativasAsignaturaPrograma as "editarActividadesFormativasAsignaturaPrograma()"
}

package "Profesorado de asignaturas" {
  usecase asignarProfesorAAsignaturaPrograma as "asignarProfesorAAsignaturaPrograma()"
  usecase desasignarProfesorAsignaturaPrograma as "desasignarProfesorAsignaturaPrograma()"
}

package "Curso académico" {
  usecase abrirCursosAcademicos as "abrirCursosAcademicos()"
  usecase crearCursoAcademico as "crearCursoAcademico()"
  usecase abrirCursoAcademico as "abrirCursoAcademico()"
  usecase editarCursoAcademico as "editarCursoAcademico()"
  usecase activarCursoAcademico as "activarCursoAcademico()"
  usecase activarSemestre as "activarSemestre()"
}

' "Configuración del programa" y "Guía docente" eran wrappers exteriores sobre
' Materia/SistemaEvaluacion/AsignaturaPrograma y Edicion/Revision/PDF -- se
' aplanan: agrupar en un único package bloquea el layout mariposa, PlantUML
' deja todo el contenido a un único lado del actor con independencia del
' sentido de la asociación.
package Materia {
  usecase abrirMaterias as "abrirMaterias()"
  usecase crearMateria as "crearMateria()"
  usecase abrirMateria as "abrirMateria()"
  usecase editarMateria as "editarMateria()"
  usecase eliminarMateria as "eliminarMateria()"
}

package SistemaEvaluacion {
  usecase abrirSistemasEvaluacion as "abrirSistemasEvaluacion()"
  usecase crearSistemaEvaluacion as "crearSistemaEvaluacion()"
  usecase abrirSistemaEvaluacion as "abrirSistemaEvaluacion()"
  usecase editarSistemaEvaluacion as "editarSistemaEvaluacion()"
  usecase eliminarSistemaEvaluacion as "eliminarSistemaEvaluacion()"
}

package AsignaturaPrograma {
  usecase crearAsignaturaPrograma as "crearAsignaturaPrograma()"
  usecase abrirAsignaturaPrograma as "abrirAsignaturaPrograma()"
  usecase editarAsignaturaPrograma as "editarAsignaturaPrograma()"
  usecase eliminarAsignaturaPrograma as "eliminarAsignaturaPrograma()"
}

package Edicion {
  usecase abrirGuia as "abrirGuia()"
}

package Revision {
  usecase consultarEstadoGuias as "consultarEstadoGuias()"
}

package "Documento de la guía" {
  usecase generarGuiasPDF as "generarGuiasPDF()"
  usecase reabrirGuiaPorIncidencia as "reabrirGuiaPorIncidencia()"
  usecase descargarGuiaPDF as "descargarGuiaPDF()"
  usecase previsualizarGuia as "previsualizarGuia()"
}

' issue #308 -- sin CRUD: CopiaSeguridad no es entidad de modeloDominio.puml,
' es un diagnóstico de infraestructura (manifiesto de backups fuera de la BD).
package "Copias de seguridad" {
  usecase consultarCopiasSeguridad as "consultarCopiasSeguridad()"
  usecase comprobarCopiasSeguridad as "comprobarCopiasSeguridad()"
  usecase crearCopiaSeguridad as "crearCopiaSeguridad()"
  usecase restaurarCopiaSeguridad as "restaurarCopiaSeguridad()"
}

package "Auditoría" {
  usecase consultarHistorialCambios as "consultarHistorialCambios()"
}

abrirSistemasEvaluacion -- Admin
crearSistemaEvaluacion -- Admin
abrirSistemaEvaluacion -- Admin
editarSistemaEvaluacion -- Admin
eliminarSistemaEvaluacion -- Admin

abrirMaterias --- Admin
crearMateria --- Admin
abrirMateria --- Admin
editarMateria --- Admin
eliminarMateria --- Admin

abrirCursosAcademicos -- Admin
crearCursoAcademico -- Admin
abrirCursoAcademico -- Admin
editarCursoAcademico -- Admin
activarCursoAcademico -- Admin
activarSemestre -- Admin


Admin -- asignarProfesorAAsignaturaPrograma
Admin -- desasignarProfesorAsignaturaPrograma

' issue #599: paridad con DirectorPrograma, vía de corrección excepcional
Admin -- asociarResultadoAprendizajeAAsignaturaPrograma
Admin -- desasociarResultadoAprendizajeAsignaturaPrograma
Admin -- asociarMetodologiaDocenteAAsignaturaPrograma
Admin -- desasociarMetodologiaDocenteAsignaturaPrograma
Admin -- editarActividadesFormativasAsignaturaPrograma

Admin --- crearAsignaturaPrograma
Admin --- abrirAsignaturaPrograma
Admin --- editarAsignaturaPrograma
Admin --- eliminarAsignaturaPrograma

Admin --- consultarEstadoGuias
Admin --- abrirGuia

Admin -- generarGuiasPDF
Admin -- descargarGuiaPDF
Admin -- previsualizarGuia
Admin -- reabrirGuiaPorIncidencia

Admin -- consultarCopiasSeguridad
Admin -- comprobarCopiasSeguridad
Admin -- crearCopiaSeguridad
Admin -- restaurarCopiaSeguridad
Admin -- consultarHistorialCambios

@enduml
