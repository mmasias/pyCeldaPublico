  usecase asociarCompetenciaAMateria as "asociarCompetenciaAMateria()"
  usecase desasociarCompetenciaAMateria as "desasociarCompetenciaAMateria()"
  usecase editarActividadesFormativasMateria as "editarActividadesFormativasMateria()"
  usecase consultarEstadoActividadesFormativasMateria as "consultarEstadoActividadesFormativasMateria()"
  ' #755: espejo de Admin en los sistemas de evaluacion de la materia.
  usecase crearSistemaEvaluacion as "crearSistemaEvaluacion()"
  usecase editarSistemaEvaluacion as "editarSistemaEvaluacion()"
  usecase eliminarSistemaEvaluacion as "eliminarSistemaEvaluacion()"
