@startuml eliminarMateria

skinparam linetype polyline

state MATERIAS_ABIERTO
state MATERIAS_ABIERTOS_SALIDA as "MATERIAS_ABIERTO"

MATERIAS_ABIERTO -[#green]-> eliminarMateria
note on link
<b>Admin</b> solicita eliminar Materia
end note

' No implementado en código -- caso de uso solo de la fase de Requisitos.
' Mismo régimen que Requisito/CursoAcademico en el modelo del dominio:
' representación correcta, pendiente de construir.
state eliminarMateria as "eliminarMateria()" {

    state " " as ConfirmandoEliminacion
    state c <<choice>>

    [*] -[#green]-> c

    c -[#green]-> ConfirmandoEliminacion
    note on link
    [Materia sin AsignaturaPrograma asociadas]
    <b>Sistema</b> presenta información de la Materia y advertencia de eliminación
    <b>Sistema</b> permite solicitar confirmar/cancelar eliminación
    end note

    c -[#red]-> [*]
    note on link
    [Materia con alguna AsignaturaPrograma asociada]
    <b>Sistema</b> presenta mensaje de bloqueo por AsignaturaPrograma asociadas
    end note

    ConfirmandoEliminacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar eliminación
    end note

    ConfirmandoEliminacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar eliminación
    end note
}

eliminarMateria -[#green]-> MATERIAS_ABIERTOS_SALIDA
note on link
lista actualizada
end note

eliminarMateria -[#red]-> MATERIAS_ABIERTOS_SALIDA
note on link
bloqueada, sin cambios
end note

eliminarMateria -[#blue]-> MATERIAS_ABIERTOS_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
