@startuml eliminarAsignatura

skinparam linetype polyline

state ASIGNATURAS_ABIERTO
state ASIGNATURAS_ABIERTOS_SALIDA as "ASIGNATURAS_ABIERTO"

ASIGNATURAS_ABIERTO -[#green]-> eliminarAsignatura
note on link
<b>Admin</b> solicita eliminar Asignatura
end note

state eliminarAsignatura as "eliminarAsignatura()" {

    state " " as ConfirmandoEliminacion

    [*] -[#green]-> ConfirmandoEliminacion
    note on link
    <b>Sistema</b> presenta información de la Asignatura y advertencia de extinción
    <b>Sistema</b> permite solicitar confirmar/cancelar eliminación
    end note

    ConfirmandoEliminacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar eliminación
    end note

    ConfirmandoEliminacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar eliminación
    end note
}

eliminarAsignatura -[#green]-> ASIGNATURAS_ABIERTOS_SALIDA
note on link
estado pasa a Extinguido, lista actualizada
end note

eliminarAsignatura -[#blue]-> ASIGNATURAS_ABIERTOS_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
