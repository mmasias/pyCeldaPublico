@startuml crearMetodologiaDocente

skinparam linetype polyline

state METODOLOGIAS_DOCENTES_ABIERTO
state METODOLOGIA_DOCENTE_ABIERTO

METODOLOGIAS_DOCENTES_ABIERTO -[#green]-> crearMetodologiaDocente
note on link
<b>Admin / DirectorPrograma</b> solicita crear metodología docente
end note

state crearMetodologiaDocente as "crearMetodologiaDocente()" {

    state " " as Datos
    state c <<choice>>

    [*] -[#green]-> Datos
    note on link
    <b>Sistema</b> presenta solicitud de datos de la metodología docente
    <b>Sistema</b> permite solicitar crear
    end note

    Datos -[#green]-> c
    note on link
    <b>Admin / DirectorPrograma</b> introduce código
    <b>Admin / DirectorPrograma</b> introduce descripción
    <b>Admin / DirectorPrograma</b> solicita crear
    end note

    c -[#green]-> [*]
    note on link
    [código no usado por otra metodología docente del Programa, sin distinguir mayúsculas]
    end note

    c -[#red]-> Datos
    note on link
    [código ya usado por otra metodología docente del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> presenta mensaje de código repetido
    end note
}

crearMetodologiaDocente -[#green]-> METODOLOGIA_DOCENTE_ABIERTO
note on link
editarMetodologiaDocente()
end note

@enduml
