@startuml desasignarProfesorAsignaturaPrograma

skinparam linetype polyline

state ASIGNATURA_PROGRAMA_ABIERTO
state ASIGNATURA_PROGRAMA_ABIERTO_SALIDA as "ASIGNATURA_PROGRAMA_ABIERTO"

ASIGNATURA_PROGRAMA_ABIERTO -[#green]-> desasignarProfesorAsignaturaPrograma
note on link
<b>Admin</b> solicita desasignar Profesor de AsignaturaPrograma
end note

state desasignarProfesorAsignaturaPrograma as "desasignarProfesorAsignaturaPrograma()" {

    state " " as ConfirmandoDesasignacion

    [*] -[#green]-> ConfirmandoDesasignacion
    note on link
    <b>Sistema</b> presenta información de la asignación y advertencia si es el único Profesor de la AsignaturaPrograma
    <b>Sistema</b> permite solicitar confirmar/cancelar desasignación
    end note

    ConfirmandoDesasignacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar desasignación
    end note

    ConfirmandoDesasignacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar desasignación
    end note
}

desasignarProfesorAsignaturaPrograma -[#green]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
lista actualizada. Si la plantilla cambio y la Guia activa esta Aprobada, pasa a
EnRevision (+ fila de HistorialCambio, autor centinela) -- al re-aprobar el director,
Guia--Profesor se re-deriva y el profesor desasignado sale de la copia.
end note

desasignarProfesorAsignaturaPrograma -[#blue]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
