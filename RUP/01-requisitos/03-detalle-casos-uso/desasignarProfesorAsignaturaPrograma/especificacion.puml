@startuml desasignarProfesorAsignaturaPrograma

skinparam linetype polyline

state ASIGNATURA_PROGRAMA_ABIERTO
state ASIGNATURA_PROGRAMA_ABIERTO_SALIDA as "ASIGNATURA_PROGRAMA_ABIERTO"

ASIGNATURA_PROGRAMA_ABIERTO -[#green]-> desasignarProfesorAsignaturaPrograma
note on link
<b>Admin</b> solicita desasignar Profesor de AsignaturaPrograma
end note

state desasignarProfesorAsignaturaPrograma as "desasignarProfesorAsignaturaPrograma()" {

    state " " as ConfirmandoDesasignacion

    [*] -[#red]-> [*]
    note on link
    <b>Sistema</b> presenta mensaje de rechazo por ser el único Profesor que imparte la AsignaturaPrograma y quedar Profesores responsables asignados
    <b>Sistema</b> permite solicitar volver
    <b>Admin</b> solicita volver
    end note

    [*] -[#green]-> ConfirmandoDesasignacion
    note on link
    <b>Sistema</b> presenta información de la asignación, según su papel, y advertencia si es el único Profesor de la AsignaturaPrograma
    <b>Sistema</b> permite solicitar confirmar/cancelar desasignación
    end note

    ConfirmandoDesasignacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar desasignación
    end note

    ConfirmandoDesasignacion -[#red]-> [*]
    note on link
    <b>Admin</b> solicita confirmar desasignación
    end note

    ConfirmandoDesasignacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar desasignación
    end note
}

desasignarProfesorAsignaturaPrograma -[#green]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
<b>Sistema</b> presenta la lista de Profesores actualizada, con su papel
end note

desasignarProfesorAsignaturaPrograma -[#blue]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
<b>Sistema</b> presenta la lista de Profesores sin cambios
end note

desasignarProfesorAsignaturaPrograma -[#red]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
<b>Sistema</b> presenta mensaje de rechazo por quedar la AsignaturaPrograma con Profesores asignados y ninguno que la imparta
<b>Sistema</b> presenta la lista de Profesores sin cambios
end note

@enduml
