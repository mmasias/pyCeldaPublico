@startuml enviarGuiaARevision

skinparam linetype polyline

state GUIA_ABIERTO
state GUIA_ABIERTO_SALIDA as "GUIA_ABIERTO"
state ASIGNATURAS_PROGRAMA_ABIERTOS_SALIDA as "ASIGNATURAS_PROGRAMA_ABIERTO"

GUIA_ABIERTO -[#green]-> enviarGuiaARevision
note on link
<b>Profesor</b> solicita enviar guía a revisión
end note

state enviarGuiaARevision as "enviarGuiaARevision()" {

    state c1 <<choice>>
    state c2 <<choice>>
    state c3 <<choice>>

    [*] -[#green]-> c1

    c1 -[#red]-> [*]
    note on link
    [Guia con PonderacionEvaluacion, ReferenciaBibliografica o Sesion pendientes de guardar]
    <b>Sistema</b> presenta error de ítems sin guardar
    end note

    c1 -[#green]-> c2

    c2 -[#red]-> [*]
    note on link
    [Guia con ponderaciones fuera de rango o sin sumar 100%]
    <b>Sistema</b> presenta error de rango o suma de ponderaciones
    end note

    c2 -[#green]-> c3

    c3 -[#green]-> [*]
    note on link
    [Guia con sesiones vinculadas mayor o igual que sesionesMinimas]
    <b>Sistema</b> presenta guía enviada a revisión
    end note

    c3 -[#red]-> [*]
    note on link
    [Guia con sesiones vinculadas menor que sesionesMinimas]
    <b>Sistema</b> presenta error de planificación docente incompleta
    end note
}

enviarGuiaARevision -[#green]-> ASIGNATURAS_PROGRAMA_ABIERTOS_SALIDA
note on link
enviada a revisión
end note

enviarGuiaARevision -[#red]-> GUIA_ABIERTO_SALIDA
note on link
rechazada, sigue en edición
end note

@enduml
