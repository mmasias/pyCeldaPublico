@startuml notificarGuiasActualizadas

skinparam linetype polyline

state GUIAS_DEL_PROGRAMA_ABIERTO
state GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA as "GUIAS_DEL_PROGRAMA_ABIERTO"

GUIAS_DEL_PROGRAMA_ABIERTO -[#green]-> notificarGuiasActualizadas
note on link
<b>DirectorPrograma</b> solicita notificar guías actualizadas
end note

state notificarGuiasActualizadas as "notificarGuiasActualizadas()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta notificación enviada
    end note
}

notificarGuiasActualizadas -[#green]-> GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA
note on link
notifica al Admin que las Guias del Programa están listas
end note

@enduml
