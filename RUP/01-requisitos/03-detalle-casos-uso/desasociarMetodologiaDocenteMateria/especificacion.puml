@startuml desasociarMetodologiaDocenteMateria

skinparam linetype polyline

state MATERIA_ABIERTO
state MATERIA_ABIERTO_SALIDA as "MATERIA_ABIERTO"

MATERIA_ABIERTO -[#green]-> desasociarMetodologiaDocenteMateria
note on link
<b>DirectorPrograma</b> solicita desasociar MetodologiaDocente de Materia
end note

state desasociarMetodologiaDocenteMateria as "desasociarMetodologiaDocenteMateria()" {

    state " " as ConfirmandoDesasociacion
    state c <<choice>>

    [*] -[#green]-> c

    c -[#green]-> ConfirmandoDesasociacion
    note on link
    [MetodologiaDocente sin AsignaturaPrograma de la Materia que la use]
    <b>Sistema</b> presenta información de la asociación y advertencia de desasociación
    <b>Sistema</b> permite solicitar confirmar/cancelar desasociación
    end note

    c -[#red]-> [*]
    note on link
    [MetodologiaDocente con alguna AsignaturaPrograma de la Materia que la use]
    <b>Sistema</b> presenta mensaje de bloqueo por uso en AsignaturaPrograma de la Materia
    end note

    ConfirmandoDesasociacion -[#green]-> [*]
    note on link
    <b>DirectorPrograma</b> solicita confirmar desasociación
    end note

    ConfirmandoDesasociacion -[#blue]-> [*]
    note on link
    <b>DirectorPrograma</b> solicita cancelar desasociación
    end note
}

desasociarMetodologiaDocenteMateria -[#green]-> MATERIA_ABIERTO_SALIDA
note on link
lista actualizada
end note

desasociarMetodologiaDocenteMateria -[#red]-> MATERIA_ABIERTO_SALIDA
note on link
bloqueada, sin cambios
end note

desasociarMetodologiaDocenteMateria -[#blue]-> MATERIA_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
