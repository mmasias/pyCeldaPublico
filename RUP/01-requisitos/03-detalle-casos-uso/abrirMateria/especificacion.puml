@startuml abrirMateria

skinparam linetype polyline

state MATERIAS_ABIERTO
state MATERIA_ABIERTO

MATERIAS_ABIERTO -[#green]-> abrirMateria
note on link
<b>Admin</b> solicita abrir Materia
end note

state abrirMateria as "abrirMateria()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> muestra datos de la Materia
    <b>Sistema</b> muestra Modulo de la Materia
    <b>Sistema</b> muestra ECTS y código RUCT de la Materia
    <b>Sistema</b> muestra Competencias de la Materia con su número de asignaturas
    <b>Sistema</b> muestra ActividadesFormativas de la Materia con sus horas y su presencialidad
    <b>Sistema</b> muestra comprobación de horas de la Materia frente a 25 h por ECTS
    <b>Sistema</b> muestra optatividad de la Materia, si la Materia suma 25 h por ECTS y sus AsignaturaPrograma no suman sus ECTS
    <b>Sistema</b> muestra SistemasEvaluacion de la Materia con su código
    end note
}

abrirMateria -[#green]-> MATERIA_ABIERTO

@enduml
