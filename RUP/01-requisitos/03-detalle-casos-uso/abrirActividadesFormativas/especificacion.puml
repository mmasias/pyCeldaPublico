@startuml abrirActividadesFormativas

skinparam linetype polyline

state PROGRAMA_ABIERTO
state ACTIVIDADES_FORMATIVAS_ABIERTO

PROGRAMA_ABIERTO -[#green]-> abrirActividadesFormativas
note on link
<b>Admin / DirectorPrograma</b> solicita abrir actividades formativas
end note

state abrirActividadesFormativas as "abrirActividadesFormativas()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta listado de actividades formativas del Programa
    <b>Sistema</b> muestra nombre y código de cada actividad formativa
    end note
}

abrirActividadesFormativas -[#green]-> ACTIVIDADES_FORMATIVAS_ABIERTO

@enduml
