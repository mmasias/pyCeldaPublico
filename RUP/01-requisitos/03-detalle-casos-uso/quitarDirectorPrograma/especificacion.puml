@startuml quitarDirectorPrograma

skinparam linetype polyline

state PROFESOR_ABIERTO
state PROGRAMA_ABIERTO
state PROFESOR_ABIERTO_SALIDA as "PROFESOR_ABIERTO"
state PROGRAMA_ABIERTO_SALIDA as "PROGRAMA_ABIERTO"

PROFESOR_ABIERTO -[#green]-> quitarDirectorPrograma
note on link
<b>Admin</b> (desde el Profesor) solicita quitar rol de director de Programa
end note

PROGRAMA_ABIERTO -[#green]-> quitarDirectorPrograma
note on link
<b>Admin</b> (desde el Programa) solicita quitar rol de director de Programa
end note

state quitarDirectorPrograma as "quitarDirectorPrograma()" {

    state " " as ConfirmandoQuitar
    state c <<choice>>

    [*] -[#green]-> c

    c -[#green]-> ConfirmandoQuitar
    note on link
    [Programa con más de un DirectorPrograma activo]
    <b>Sistema</b> presenta Profesor, Programa y lo que implica quitar el rol
    <b>Sistema</b> permite solicitar confirmar/cancelar
    end note

    c -[#red]-> [*]
    note on link
    [Programa con un único DirectorPrograma activo]
    <b>Sistema</b> presenta mensaje de bloqueo por ser el único DirectorPrograma del Programa
    end note

    ConfirmandoQuitar -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar
    end note

    ConfirmandoQuitar -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar
    end note
}

quitarDirectorPrograma -[#green]-> PROFESOR_ABIERTO_SALIDA
note on link
rol quitado, lista actualizada
(vuelve a la pantalla de la que salió)
end note

quitarDirectorPrograma -[#green]-> PROGRAMA_ABIERTO_SALIDA

quitarDirectorPrograma -[#red]-> PROFESOR_ABIERTO_SALIDA
note on link
bloqueada, sin cambios
end note

quitarDirectorPrograma -[#red]-> PROGRAMA_ABIERTO_SALIDA

quitarDirectorPrograma -[#blue]-> PROFESOR_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

quitarDirectorPrograma -[#blue]-> PROGRAMA_ABIERTO_SALIDA

@enduml
