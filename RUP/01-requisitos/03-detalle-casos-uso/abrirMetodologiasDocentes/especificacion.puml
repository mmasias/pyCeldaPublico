@startuml abrirMetodologiasDocentes

skinparam linetype polyline

state PROGRAMA_ABIERTO
state METODOLOGIAS_DOCENTES_ABIERTO

PROGRAMA_ABIERTO -[#green]-> abrirMetodologiasDocentes
note on link
<b>Admin / DirectorPrograma</b> solicita abrir metodologías docentes
end note

state abrirMetodologiasDocentes as "abrirMetodologiasDocentes()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta listado de metodologías docentes del Programa
    <b>Sistema</b> muestra número de asignaturas de cada metodología docente
    end note
}

abrirMetodologiasDocentes -[#green]-> METODOLOGIAS_DOCENTES_ABIERTO

@enduml
