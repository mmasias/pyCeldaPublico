@startuml abrirMetodologiasDocentes

skinparam linetype polyline

state SISTEMA_DISPONIBLE
state METODOLOGIAS_DOCENTES_ABIERTO

SISTEMA_DISPONIBLE -[#green]-> abrirMetodologiasDocentes
note on link
<b>Admin</b> solicita abrir Metodologías Docentes
end note

state abrirMetodologiasDocentes as "abrirMetodologiasDocentes()" {

    state " " as ListandoCatalogo

    [*] -[#green]-> ListandoCatalogo
    note on link
    <b>Sistema</b> presenta selector de Universidad
    <b>Sistema</b> presenta listado de MetodologiaDocente de la Universidad seleccionada
    end note

    ListandoCatalogo -[#green]-> [*]
    note on link
    <b>Admin</b> elige Universidad
    end note
}

abrirMetodologiasDocentes -[#green]-> METODOLOGIAS_DOCENTES_ABIERTO

@enduml
