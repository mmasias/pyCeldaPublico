@startuml eliminarAsignaturaGrado

skinparam linetype polyline

state GRADO_ABIERTO
state GRADO_ABIERTO_SALIDA as "GRADO_ABIERTO"

GRADO_ABIERTO -[#green]-> eliminarAsignaturaGrado
note on link
<b>Admin</b> solicita eliminar AsignaturaGrado
end note

state eliminarAsignaturaGrado as "eliminarAsignaturaGrado()" {

    state " " as ConfirmandoEliminacion

    [*] -[#green]-> ConfirmandoEliminacion
    note on link
    <b>Sistema</b> presenta información de la AsignaturaGrado y advertencia de extinción
    <b>Sistema</b> permite solicitar confirmar/cancelar eliminación
    end note

    ConfirmandoEliminacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar eliminación
    end note

    ConfirmandoEliminacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar eliminación
    end note
}

eliminarAsignaturaGrado -[#green]-> GRADO_ABIERTO_SALIDA
note on link
estado pasa a Extinguido, lista actualizada
end note

eliminarAsignaturaGrado -[#blue]-> GRADO_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
