@startuml crearActividadFormativa

skinparam linetype polyline

state ACTIVIDADES_FORMATIVAS_ABIERTO
state ACTIVIDAD_FORMATIVA_ABIERTO

ACTIVIDADES_FORMATIVAS_ABIERTO -[#green]-> crearActividadFormativa
note on link
<b>Admin / DirectorPrograma</b> solicita crear actividad formativa
end note

state crearActividadFormativa as "crearActividadFormativa()" {

    state " " as Datos
    state c <<choice>>

    [*] -[#green]-> Datos
    note on link
    <b>Sistema</b> presenta solicitud de datos de la actividad formativa
    <b>Sistema</b> permite solicitar crear
    end note

    Datos -[#green]-> c
    note on link
    <b>Admin / DirectorPrograma</b> introduce código
    <b>Admin / DirectorPrograma</b> introduce nombre
    <b>Admin / DirectorPrograma</b> solicita crear
    end note

    c -[#green]-> [*]
    note on link
    [código no usado por otra actividad formativa del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> añade la actividad formativa, a 0 horas, a cada Materia y AsignaturaPrograma del Programa
    end note

    c -[#red]-> Datos
    note on link
    [código ya usado por otra actividad formativa del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> presenta mensaje de código repetido
    end note
}

crearActividadFormativa -[#green]-> ACTIVIDAD_FORMATIVA_ABIERTO
note on link
editarActividadFormativa()
end note

@enduml
