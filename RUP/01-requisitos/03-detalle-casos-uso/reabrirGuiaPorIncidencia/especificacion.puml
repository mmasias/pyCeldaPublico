@startuml reabrirGuiaPorIncidencia

skinparam linetype polyline

state GUIA_ABIERTO
state GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA as "GUIAS_DEL_PROGRAMA_ABIERTO"

GUIA_ABIERTO -[#green]-> reabrirGuiaPorIncidencia
note on link
<b>Admin</b> solicita reabrir Guia
end note

' No implementado en código -- caso de uso solo de la fase de Requisitos.
' Mismo régimen que Requisito/CursoAcademico en el modelo del dominio:
' representación correcta, pendiente de construir.
state reabrirGuiaPorIncidencia as "reabrirGuiaPorIncidencia()" {

    state " " as IntroduciendoComentario

    [*] -[#green]-> IntroduciendoComentario
    note on link
    <b>Sistema</b> permite introducir comentario
    <b>Sistema</b> permite solicitar reabrir
    end note

    IntroduciendoComentario -[#green]-> [*]
    note on link
    <b>Admin</b> introduce comentario
    <b>Admin</b> solicita reabrir
    end note
}

reabrirGuiaPorIncidencia -[#green]-> GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA
note on link
Aprobada -> EnRevision; registra comentario (obligatorio) en HistorialCambio
end note

@enduml
