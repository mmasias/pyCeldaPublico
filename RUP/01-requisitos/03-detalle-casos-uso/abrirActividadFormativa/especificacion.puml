@startuml abrirActividadFormativa

skinparam linetype polyline

state ACTIVIDADES_FORMATIVAS_ABIERTO
state ACTIVIDAD_FORMATIVA_ABIERTO

ACTIVIDADES_FORMATIVAS_ABIERTO -[#green]-> abrirActividadFormativa
note on link
<b>Admin / DirectorPrograma</b> solicita abrir actividad formativa
end note

state abrirActividadFormativa as "abrirActividadFormativa()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> muestra código y nombre de la actividad formativa
    end note
}

abrirActividadFormativa -[#green]-> ACTIVIDAD_FORMATIVA_ABIERTO

@enduml
