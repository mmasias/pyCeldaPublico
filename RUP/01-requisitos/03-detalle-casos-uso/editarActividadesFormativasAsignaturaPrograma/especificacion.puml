@startuml editarActividadesFormativasAsignaturaPrograma

skinparam linetype polyline

state ASIGNATURA_PROGRAMA_ABIERTO
state ASIGNATURA_PROGRAMA_ABIERTO_SALIDA as "ASIGNATURA_PROGRAMA_ABIERTO"

ASIGNATURA_PROGRAMA_ABIERTO -[#green]-> editarActividadesFormativasAsignaturaPrograma
note on link
<b>DirectorPrograma</b> solicita editar las actividades formativas de la AsignaturaPrograma
end note

state editarActividadesFormativasAsignaturaPrograma as "editarActividadesFormativasAsignaturaPrograma()" {

    state " " as EditandoReparto
    state c <<choice>>

    [*] -[#green]-> EditandoReparto
    note on link
    <b>Sistema</b> presenta las actividades formativas del catálogo del Programa con sus horas actuales
    <b>Sistema</b> muestra el porcentaje de presencialidad de cada actividad formativa en la Materia
    <b>Sistema</b> permite solicitar guardar
    end note

    EditandoReparto -[#green]-> c
    note on link
    <b>DirectorPrograma</b> introduce las horas de cada actividad formativa
    <b>DirectorPrograma</b> solicita guardar
    end note

    c -[#green]-> [*]
    note on link
    [horas >= 0 en todas las actividades formativas]
    <b>Sistema</b> presenta el reparto guardado
    end note

    c -[#red]-> [*]
    note on link
    [alguna hora negativa]
    <b>Sistema</b> presenta mensaje de horas no válidas (valor negativo)
    end note
}

editarActividadesFormativasAsignaturaPrograma -[#green]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA

editarActividadesFormativasAsignaturaPrograma -[#red]-> ASIGNATURA_PROGRAMA_ABIERTO_SALIDA
note on link
algún valor de horas no válido, no se guarda nada
end note

@enduml
