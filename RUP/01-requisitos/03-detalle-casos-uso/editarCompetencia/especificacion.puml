@startuml editarCompetencia

skinparam linetype polyline

state COMPETENCIA_ABIERTO
state COMPETENCIA_ABIERTO_SALIDA as "COMPETENCIA_ABIERTO"

COMPETENCIA_ABIERTO -[#green]-> editarCompetencia
note on link
<b>Admin / DirectorPrograma</b> solicita editar competencia
end note

state editarCompetencia as "editarCompetencia()" {

    state " " as Datos
    state c <<choice>>

    [*] -[#green]-> Datos
    note on link
    <b>Sistema</b> presenta datos actuales de la competencia
    <b>Sistema</b> presenta selección de tipo (Básica, General, Transversal, Específica)
    <b>Sistema</b> permite solicitar guardar
    end note

    Datos -[#green]-> c
    note on link
    <b>Admin / DirectorPrograma</b> introduce código
    <b>Admin / DirectorPrograma</b> selecciona tipo
    <b>Admin / DirectorPrograma</b> introduce descripción
    <b>Admin / DirectorPrograma</b> solicita guardar
    end note

    c -[#green]-> [*]
    note on link
    [código no usado por otra competencia del Programa, sin distinguir mayúsculas]
    end note

    c -[#red]-> Datos
    note on link
    [código ya usado por otra competencia del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> presenta mensaje de código repetido
    end note
}

editarCompetencia -[#green]-> COMPETENCIA_ABIERTO_SALIDA

@enduml
