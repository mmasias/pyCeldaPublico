@startuml aprobarGuia

skinparam linetype polyline

state GUIA_ABIERTO
state GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA as "GUIAS_DEL_PROGRAMA_ABIERTO"

GUIA_ABIERTO -[#green]-> aprobarGuia
note on link
<b>DirectorPrograma</b> solicita aprobar Guia
end note

state aprobarGuia as "aprobarGuia()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta Guia aprobada, con estado anterior, estado actual y comentario registrado
    <b>Sistema</b> permite solicitar volver a las guías
    <b>DirectorPrograma</b> solicita volver a las guías
    end note
}

aprobarGuia -[#green]-> GUIAS_DEL_PROGRAMA_ABIERTOS_SALIDA
note on link
EnRevision -> Aprobada; registra "aprobada sin incidencia" en HistorialCambio
end note

@enduml
