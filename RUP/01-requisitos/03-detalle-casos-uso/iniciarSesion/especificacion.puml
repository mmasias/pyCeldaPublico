@startuml iniciarSesion

skinparam linetype polyline

state SESION_CERRADA
state INICIO_ABIERTO_SALIDA as "INICIO_ABIERTO"
state SESION_CERRADA_SALIDA as "SESION_CERRADA"

SESION_CERRADA -[#green]-> iniciarSesion
note on link
<b>UsuarioNoLogueado</b> introduce credenciales
end note

state iniciarSesion as "iniciarSesion()" {

    state c <<choice>>

    [*] -[#green]-> c

    c -[#green]-> [*]
    note on link
    [email autenticado por Google, dentro del dominio institucional, y ya registrado como Profesor o Admin]
    <b>Sistema</b> presenta el punto de partida propio del rol identificado
    <b>punto de extensión:</b> tras validación exitosa
    end note

    c -[#red]-> [*]
    note on link
    [email autenticado por Google fuera del dominio institucional configurado]
    <b>Sistema</b> presenta mensaje de cuenta fuera del dominio institucional
    end note

    c -[#orange]-> [*]
    note on link
    [email autenticado por Google, dentro del dominio institucional, pero no registrado como Profesor ni Admin]
    <b>Sistema</b> presenta mensaje de cuenta no autorizada -- sin auto-registro
    end note
}

iniciarSesion -[#green]-> INICIO_ABIERTO_SALIDA

iniciarSesion -[#red]-> SESION_CERRADA_SALIDA
note on link
fuera de dominio institucional, self-loop
end note

iniciarSesion -[#orange]-> SESION_CERRADA_SALIDA
note on link
cuenta no autorizada, self-loop
end note

@enduml
