@startuml importarPlanificacionDocenteDeGuiaHermana

skinparam linetype polyline

state PLANIFICACION_DOCENTE_ABIERTO
state PLANIFICACION_DOCENTE_ABIERTO_SALIDA as "PLANIFICACION_DOCENTE_ABIERTO"

PLANIFICACION_DOCENTE_ABIERTO -[#green]-> importarPlanificacionDocenteDeGuiaHermana
note on link
<b>Profesor</b> solicita importar planificación docente de una asignatura hermana
end note

state importarPlanificacionDocenteDeGuiaHermana as "importarPlanificacionDocenteDeGuiaHermana()" {

    state c <<choice>>
    state " " as SolicitandoOrigen

    [*] -[#green]-> c

    c -[#red]-> [*]
    note on link
    [ninguna AsignaturaPrograma hermana tiene Guia importable en el CursoAcademico activo]
    <b>Sistema</b> presenta mensaje de bloqueo: ninguna asignatura hermana tiene guía aprobada, o en revisión que el Profesor también imparta
    end note

    c -[#green]-> SolicitandoOrigen
    note on link
    [al menos una AsignaturaPrograma hermana tiene Guia importable en el CursoAcademico activo]
    <i>Guia importable: Aprobada, o EnRevision de una AsignaturaPrograma que el Profesor también imparte</i>
    <b>Sistema</b> presenta las guías importables de asignaturas hermanas del CursoAcademico activo
    <b>Sistema</b> muestra el estado de cada guía origen y su fecha
    <b>Sistema</b> muestra el número de sesiones que se reemplazarán
    end note

    SolicitandoOrigen -[#green]-> [*]
    note on link
    <b>Profesor</b> selecciona la guía origen
    <b>Profesor</b> solicita importar
    end note
}

importarPlanificacionDocenteDeGuiaHermana -[#green]-> PLANIFICACION_DOCENTE_ABIERTO_SALIDA
note on link
reemplaza la planificación docente; si la guía estaba Aprobada, pasa a Borrador
end note

importarPlanificacionDocenteDeGuiaHermana -[#red]-> PLANIFICACION_DOCENTE_ABIERTO_SALIDA

@enduml
