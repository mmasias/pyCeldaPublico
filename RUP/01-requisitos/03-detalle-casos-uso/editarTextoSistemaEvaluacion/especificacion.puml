@startuml editarTextoSistemaEvaluacion

skinparam linetype polyline

state PONDERACIONES_EVALUACION_ABIERTO
state PONDERACIONES_EVALUACION_ABIERTO_SALIDA as "PONDERACIONES_EVALUACION_ABIERTO"

PONDERACIONES_EVALUACION_ABIERTO -[#green]-> editarTextoSistemaEvaluacion
note on link
<b>Profesor</b> solicita editar el texto de convocatorias
<b>DirectorPrograma</b> solicita editar el texto de convocatorias como corrección excepcional
end note

state editarTextoSistemaEvaluacion as "editarTextoSistemaEvaluacion()" {

    state " " as EligiendoPlantilla
    state c <<choice>>

    [*] -[#green]-> EligiendoPlantilla
    note on link
    <b>Sistema</b> presenta la plantilla aplicada (la elegida o la del carácter de la asignatura)
    <b>Sistema</b> presenta el instrumento y el porcentaje de la convocatoria extraordinaria, si la plantilla los tiene
    <b>Sistema</b> presenta la propuesta de instrumento y de porcentaje según los instrumentos de evaluación final
    <b>Sistema</b> presenta el texto resultante, no editable
    <b>Sistema</b> permite solicitar guardar
    end note

    EligiendoPlantilla -[#green]-> c
    note on link
    <b>Profesor</b> o <b>DirectorPrograma</b> elige la plantilla
    <b>Profesor</b> o <b>DirectorPrograma</b> introduce el instrumento y el porcentaje, o usa la propuesta
    <b>Profesor</b> o <b>DirectorPrograma</b> solicita guardar
    end note

    c -[#green]-> [*]
    note on link
    [plantilla conocida, porcentaje vacío o entre 1 y 100, instrumento de 300 caracteres como máximo]
    [lo guarda el Profesor y la guía está Aprobada] <b>Sistema</b> devuelve la guía a Borrador
    [lo guarda el DirectorPrograma y la guía está Aprobada] <b>Sistema</b> devuelve la guía a Borrador
    [lo guarda el DirectorPrograma y la guía está EnRevision] <b>Sistema</b> pasa la guía a Rechazada
    <b>Sistema</b> persiste la plantilla y los datos y registra el cambio en el historial
    end note

    c -[#red]-> [*]
    note on link
    [plantilla desconocida, porcentaje fuera de 1-100 o instrumento demasiado largo]
    <b>Sistema</b> presenta mensaje de rechazo
    end note
}

editarTextoSistemaEvaluacion -[#green]-> PONDERACIONES_EVALUACION_ABIERTO_SALIDA
note on link
texto de convocatorias actualizado
end note

editarTextoSistemaEvaluacion -[#red]-> PONDERACIONES_EVALUACION_ABIERTO_SALIDA
note on link
datos inválidos, sin cambios
end note

@enduml
