@startuml eliminarActividadFormativa

skinparam linetype polyline

state ACTIVIDADES_FORMATIVAS_ABIERTO
state ACTIVIDADES_FORMATIVAS_ABIERTO_SALIDA as "ACTIVIDADES_FORMATIVAS_ABIERTO"

ACTIVIDADES_FORMATIVAS_ABIERTO -[#green]-> eliminarActividadFormativa
note on link
<b>Admin / DirectorPrograma</b> solicita eliminar actividad formativa
end note

state eliminarActividadFormativa as "eliminarActividadFormativa()" {

    state " " as ConfirmandoEliminacion
    state c <<choice>>

    [*] -[#green]-> ConfirmandoEliminacion
    note on link
    <b>Sistema</b> presenta código y nombre de la actividad formativa y advertencia de eliminación
    <b>Sistema</b> permite solicitar confirmar/cancelar eliminación
    end note

    ConfirmandoEliminacion -[#green]-> c
    note on link
    <b>Admin / DirectorPrograma</b> solicita confirmar eliminación
    end note

    c -[#green]-> [*]
    note on link
    [sin horas en ninguna Materia ni AsignaturaPrograma del Programa]
    <b>Sistema</b> retira la actividad formativa de las Materias y AsignaturaPrograma, donde está a 0 horas
    end note

    c -[#red]-> [*]
    note on link
    [con horas en alguna Materia o en alguna de sus AsignaturaPrograma]
    <b>Sistema</b> presenta mensaje de bloqueo con las Materias en las que está en uso
    end note

    ConfirmandoEliminacion -[#blue]-> [*]
    note on link
    <b>Admin / DirectorPrograma</b> solicita cancelar eliminación
    end note
}

eliminarActividadFormativa -[#green]-> ACTIVIDADES_FORMATIVAS_ABIERTO_SALIDA
note on link
lista actualizada
end note

eliminarActividadFormativa -[#red]-> ACTIVIDADES_FORMATIVAS_ABIERTO_SALIDA
note on link
bloqueada, sin cambios
end note

eliminarActividadFormativa -[#blue]-> ACTIVIDADES_FORMATIVAS_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
