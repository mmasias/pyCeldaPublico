@startuml crearFacultad

skinparam linetype polyline

state FACULTADES_ABIERTO
state FACULTAD_ABIERTO

FACULTADES_ABIERTO -[#green]-> crearFacultad
note on link
<b>Admin</b> solicita crear Facultad
end note

state crearFacultad as "crearFacultad()" {

    state " " as SolicitandoDatos

    [*] -[#green]-> SolicitandoDatos
    note on link
    <b>Sistema</b> presenta solicitud de nombre de la Facultad
    <b>Sistema</b> permite solicitar crear
    end note

    SolicitandoDatos -[#green]-> [*]
    note on link
    <b>Admin</b> introduce nombre
    <b>Admin</b> solicita crear
    end note
}

crearFacultad -[#green]-> FACULTAD_ABIERTO
note on link
editarFacultad()
end note

@enduml
