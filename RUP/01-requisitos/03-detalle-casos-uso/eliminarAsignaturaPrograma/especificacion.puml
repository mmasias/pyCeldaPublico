@startuml eliminarAsignaturaPrograma

skinparam linetype polyline

state PROGRAMA_ABIERTO
state PROGRAMA_ABIERTO_SALIDA as "PROGRAMA_ABIERTO"

PROGRAMA_ABIERTO -[#green]-> eliminarAsignaturaPrograma
note on link
<b>Admin</b> solicita eliminar AsignaturaPrograma
end note

state eliminarAsignaturaPrograma as "eliminarAsignaturaPrograma()" {

    state " " as ConfirmandoEliminacion

    [*] -[#green]-> ConfirmandoEliminacion
    note on link
    <b>Sistema</b> presenta información de la AsignaturaPrograma y advertencia de extinción
    <b>Sistema</b> permite solicitar confirmar/cancelar eliminación
    end note

    ConfirmandoEliminacion -[#green]-> [*]
    note on link
    <b>Admin</b> solicita confirmar eliminación
    end note

    ConfirmandoEliminacion -[#blue]-> [*]
    note on link
    <b>Admin</b> solicita cancelar eliminación
    end note
}

eliminarAsignaturaPrograma -[#green]-> PROGRAMA_ABIERTO_SALIDA
note on link
estado pasa a Extinguido, lista actualizada
end note

eliminarAsignaturaPrograma -[#blue]-> PROGRAMA_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
