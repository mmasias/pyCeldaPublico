@startuml desasociarResultadoAprendizajeAsignaturaGrado

skinparam linetype polyline

state ASIGNATURA_GRADO_ABIERTO
state ASIGNATURA_GRADO_ABIERTO_SALIDA as "ASIGNATURA_GRADO_ABIERTO"

ASIGNATURA_GRADO_ABIERTO -[#green]-> desasociarResultadoAprendizajeAsignaturaGrado
note on link
<b>DirectorGrado</b> solicita desasociar ResultadoAprendizaje de AsignaturaGrado
end note

state desasociarResultadoAprendizajeAsignaturaGrado as "desasociarResultadoAprendizajeAsignaturaGrado()" {

    state " " as ConfirmandoDesasociacion

    [*] -[#green]-> ConfirmandoDesasociacion
    note on link
    <b>Sistema</b> presenta información de la asociación y advertencia si es el único ResultadoAprendizaje de la AsignaturaGrado
    <b>Sistema</b> permite solicitar confirmar/cancelar desasociación
    end note

    ConfirmandoDesasociacion -[#green]-> [*]
    note on link
    <b>DirectorGrado</b> solicita confirmar desasociación
    end note

    ConfirmandoDesasociacion -[#blue]-> [*]
    note on link
    <b>DirectorGrado</b> solicita cancelar desasociación
    end note
}

desasociarResultadoAprendizajeAsignaturaGrado -[#green]-> ASIGNATURA_GRADO_ABIERTO_SALIDA
note on link
lista actualizada
end note

desasociarResultadoAprendizajeAsignaturaGrado -[#blue]-> ASIGNATURA_GRADO_ABIERTO_SALIDA
note on link
cancelada, sin cambios
end note

@enduml
