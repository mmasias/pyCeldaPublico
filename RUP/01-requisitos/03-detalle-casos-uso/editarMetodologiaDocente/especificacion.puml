@startuml editarMetodologiaDocente

skinparam linetype polyline

state METODOLOGIA_DOCENTE_ABIERTO
state METODOLOGIA_DOCENTE_ABIERTO_SALIDA as "METODOLOGIA_DOCENTE_ABIERTO"

METODOLOGIA_DOCENTE_ABIERTO -[#green]-> editarMetodologiaDocente
note on link
<b>Admin / DirectorPrograma</b> solicita editar metodología docente
end note

state editarMetodologiaDocente as "editarMetodologiaDocente()" {

    state " " as Datos
    state c <<choice>>

    [*] -[#green]-> Datos
    note on link
    <b>Sistema</b> presenta datos actuales de la metodología docente
    <b>Sistema</b> permite solicitar guardar
    end note

    Datos -[#green]-> c
    note on link
    <b>Admin / DirectorPrograma</b> introduce código
    <b>Admin / DirectorPrograma</b> introduce descripción
    <b>Admin / DirectorPrograma</b> solicita guardar
    end note

    c -[#green]-> [*]
    note on link
    [código no usado por otra metodología docente del Programa, sin distinguir mayúsculas]
    end note

    c -[#red]-> Datos
    note on link
    [código ya usado por otra metodología docente del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> presenta mensaje de código repetido
    end note
}

editarMetodologiaDocente -[#green]-> METODOLOGIA_DOCENTE_ABIERTO_SALIDA

@enduml
