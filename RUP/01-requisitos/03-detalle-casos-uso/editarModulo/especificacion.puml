@startuml editarModulo

skinparam linetype polyline

state MODULOS_ABIERTO
state MODULOS_ABIERTO_SALIDA as "MODULOS_ABIERTO"

MODULOS_ABIERTO -[#green]-> editarModulo
note on link
<b>Admin</b> solicita editar módulo
end note

state editarModulo as "editarModulo()" {

    state " " as Datos
    state c <<choice>>

    [*] -[#green]-> Datos
    note on link
    <b>Sistema</b> presenta datos actuales del módulo
    <b>Sistema</b> permite solicitar guardar
    end note

    Datos -[#green]-> c
    note on link
    <b>Admin</b> introduce código
    <b>Admin</b> introduce nombre
    <b>Admin</b> introduce descripción (opcional)
    <b>Admin</b> solicita guardar
    end note

    c -[#green]-> [*]
    note on link
    [código no usado por otro módulo del Programa, sin distinguir mayúsculas]
    end note

    c -[#red]-> Datos
    note on link
    [código ya usado por otro módulo del Programa, sin distinguir mayúsculas]
    <b>Sistema</b> presenta mensaje de código repetido
    end note
}

editarModulo -[#green]-> MODULOS_ABIERTO_SALIDA
note on link
lista actualizada
end note

@enduml
