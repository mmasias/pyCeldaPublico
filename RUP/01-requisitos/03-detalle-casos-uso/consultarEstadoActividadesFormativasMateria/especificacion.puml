@startuml consultarEstadoActividadesFormativasMateria

skinparam linetype polyline

state MATERIA_ABIERTO
state MATERIA_ABIERTO_SALIDA as "MATERIA_ABIERTO"

MATERIA_ABIERTO -[#green]-> consultarEstadoActividadesFormativasMateria
note on link
<b>DirectorPrograma</b> solicita consultar el estado de las actividades formativas de la Materia
end note

state consultarEstadoActividadesFormativasMateria as "consultarEstadoActividadesFormativasMateria()" {

    [*] -[#green]-> [*]
    note on link
    <b>Sistema</b> presenta las actividades formativas del catálogo del Programa con las horas de la materia y la suma de las de sus AsignaturaPrograma
    <b>Sistema</b> visualiza las actividades formativas cuya regla AfM = ΣAfAdM no cuadra
    <b>Sistema</b> muestra las horas de la materia frente a 25 h por ECTS, si la Materia tiene ECTS
    end note
}

consultarEstadoActividadesFormativasMateria -[#green]-> MATERIA_ABIERTO_SALIDA

@enduml
