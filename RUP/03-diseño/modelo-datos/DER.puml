@startuml DER

' GENERADO por backend/app/scripts/generar_modelo_datos.py -- no editar a mano.
' El 'por qué' (packages, etiquetas, notas) son constantes curadas de ese script.

hide circle
hide empty members
skinparam linetype ortho

package "Estructura curricular" {
  class universidades {
    id : Integer <<PK>>
    nombre : String(200)
  }
  class facultades {
    id : Integer <<PK>>
    nombre : String(200)
    universidad_id : Integer <<FK>>
  }
  class programas_padre {
    id : Integer <<PK>>
    nombre : String(200)
  }
  class programas {
    id : Integer <<PK>>
    codigo : String(20)
    nombre : String(200)
    estado : String(20)
    facultad_id : Integer <<FK>>
    programa_padre_id : Integer <<FK>>
  }
  class materias {
    id : Integer <<PK>>
    nombre : String(200)
    programa_id : Integer <<FK>>
  }
  class asignaturas {
    id : Integer <<PK>>
    codigo : String(20)
    nombre : String(200)
    ects : Integer
    contenido : String
    estado : String(20)
  }
  class asignaturas_programa {
    id : Integer <<PK>>
    materia_id : Integer <<FK>>
    asignatura_id : Integer <<FK>>
    nombre : String(200)
    curso : Integer
    caracter : String(50)
    idioma : String(50)
    ects : Numeric(4, 1)
    semestre_default : Integer
    contenido : Text
    requisitos_previos : Text
    sesiones_minimas : Integer
    estado : String(20)
  }
  class sistemas_evaluacion {
    id : Integer <<PK>>
    materia_id : Integer <<FK>>
    tipo : String(50)
    descripcion : String(200)
    ponderacion_minima : Numeric(5, 2)
    ponderacion_maxima : Numeric(5, 2)
  }
  class metodologias_docentes {
    id : Integer <<PK>>
    universidad_id : Integer <<FK>>
    codigo : String(20)
    descripcion : String(500)
  }
  class metodologias_materia {
    materia_id : Integer <<PK,FK>>
    metodologia_docente_id : Integer <<PK,FK>>
    descripcion_propia : Text
  }
  class programas_metodologias_docentes {
    programa_id : Integer <<PK,FK>>
    metodologia_docente_id : Integer <<PK,FK>>
  }
  class resultados_aprendizaje {
    id : Integer <<PK>>
    programa_id : Integer <<FK>>
    codigo : String(20)
    tipo : String(50)
    descripcion : String(500)
  }
  class materias_resultados_aprendizaje {
    materia_id : Integer <<PK,FK>>
    resultado_aprendizaje_id : Integer <<PK,FK>>
  }
  class asignaturas_programa_metodologias_docentes {
    asignatura_programa_id : Integer <<PK,FK>>
    metodologia_docente_id : Integer <<PK,FK>>
  }
  class asignaturas_programa_resultados_aprendizaje {
    asignatura_programa_id : Integer <<PK,FK>>
    resultado_aprendizaje_id : Integer <<PK,FK>>
  }
  class asignaturas_programa_profesores {
    asignatura_programa_id : Integer <<PK,FK>>
    profesor_id : Integer <<PK,FK>>
  }
  class actividades_formativas {
    id : Integer <<PK>>
    universidad_id : Integer <<FK>>
    codigo : String(10)
    nombre : String(200)
  }
  class actividades_formativas_materia {
    materia_id : Integer <<PK,FK>>
    actividad_formativa_id : Integer <<PK,FK>>
    horas : Numeric(6, 2)
  }
  class actividades_formativas_asignatura_programa {
    asignatura_programa_id : Integer <<PK,FK>>
    actividad_formativa_id : Integer <<PK,FK>>
    horas : Numeric(6, 2)
    porcentaje_presencialidad : Numeric(5, 2)
  }
  class cursos_academicos {
    id : Integer <<PK>>
    inicio : Date
    fin : Date
    estado : String(20)
    universidad_id : Integer <<FK>>
    semestre_activo : Integer
  }
}

package "Guía docente" {
  class guias {
    id : Integer <<PK>>
    estado : String(20)
    semestre : Integer
    contenido : Text
    texto_sistema_evaluacion : Text
    sesiones_minimas : Integer
    programa_id : Integer <<FK lógica>>
    asignatura_programa_id : Integer <<FK>>
    curso_academico_id : Integer <<FK>>
    fecha_creacion : DateTimeUTC
    fecha_ultima_modificacion : DateTimeUTC
    fecha_generacion_pdf : DateTimeUTC
  }
  class ponderaciones_evaluacion {
    id : Integer <<PK>>
    guia_id : Integer <<FK>>
    sistema_evaluacion_id : Integer <<FK>>
    descripcion : String(200)
    ponderacion : Numeric(5, 2)
    vinculada : Boolean
  }
  class referencias_bibliograficas {
    id : Integer <<PK>>
    guia_id : Integer <<FK>>
    tipo : String(30)
    referencia : String(500)
    vinculada : Boolean
  }
  class sesiones {
    id : Integer <<PK>>
    guia_id : Integer <<FK>>
    numero : Integer
    tipo : String(30)
    descripcion : String(500)
    vinculada : Boolean
  }
  class historial_cambios {
    id : Integer <<PK>>
    guia_id : Integer <<FK>>
    autor_id : Integer <<FK lógica poli>>
    campo : String(50)
    valor_anterior : String(50)
    valor_nuevo : String(50)
    comentario : String(200)
    fecha : DateTimeUTC
  }
  class guias_profesores {
    guia_id : Integer <<PK,FK>>
    profesor_id : Integer <<PK,FK>>
  }
}

package "Personas y roles" {
  class profesores {
    id : Integer <<PK>>
    email : String(200)
    nombre : String(200)
    universidad_id : Integer <<FK>>
  }
  class directores_programa {
    id : Integer <<PK>>
    email : String(200)
  }
  class programas_directores_programa {
    programa_id : Integer <<PK,FK>>
    director_programa_id : Integer <<PK,FK>>
  }
  class perfiles_profesor_curso {
    id : Integer <<PK>>
    profesor_id : Integer <<FK>>
    curso_academico_id : Integer <<FK>>
    validado : Boolean
    orcid : String(19)
    enlace_cvn : String(300)
    enlace_foto : String(300)
    enlace_scholar : String(300)
    es_doctor : Boolean
    universidad_doctorado : String(200)
    anio_doctorado : Integer
    programa_doctorado : String(200)
    mencion_internacional : Boolean
    nivel_acreditacion_siiu : Integer
    organismo_acreditador : String(10)
    organismo_acreditador_otro : String(200)
    num_sexenios : Integer
    anio_ultimo_sexenio : Integer
    tramitando_sexenio : Boolean
    num_quinquenios : Integer
    anio_ultimo_quinquenio : Integer
    biografia : String(2000)
    anios_experiencia_docente : Integer
    anios_experiencia_docente_virtual : Integer
    anios_experiencia_profesional : Integer
    anios_experiencia_investigadora : Integer
  }
}

' --- Relaciones (crow's foot) ---
actividades_formativas }--|| universidades
actividades_formativas_asignatura_programa }--|| asignaturas_programa : reparte en
actividades_formativas_asignatura_programa }--|| actividades_formativas : instancia de
actividades_formativas_materia }--|| materias : reparte en
actividades_formativas_materia }--|| actividades_formativas : instancia de
asignaturas_programa ||--{ asignaturas_programa_metodologias_docentes
metodologias_docentes ||--{ asignaturas_programa_metodologias_docentes
asignaturas_programa ||--{ asignaturas_programa_resultados_aprendizaje
resultados_aprendizaje ||--{ asignaturas_programa_resultados_aprendizaje
asignaturas_programa ||--{ asignaturas_programa_profesores
profesores ||--{ asignaturas_programa_profesores
asignaturas_programa }--|| materias : concreta
asignaturas_programa }--o| asignaturas
cursos_academicos }--o| universidades
facultades }--|| universidades : pertenece a
programas ||--{ programas_directores_programa
directores_programa ||--{ programas_directores_programa
programas ||--{ programas_metodologias_docentes
metodologias_docentes ||--{ programas_metodologias_docentes
programas }--o| facultades : adscrito a
programas }--o| programas_padre : versión de
guias ||--{ guias_profesores
profesores ||--{ guias_profesores
guias }--o| asignaturas_programa : materializa
guias }--|| cursos_academicos : cursada en
historial_cambios }--|| guias : audita
materias ||--{ materias_resultados_aprendizaje
resultados_aprendizaje ||--{ materias_resultados_aprendizaje
materias }--o| programas : del plan de
metodologias_docentes }--|| universidades
metodologias_materia }--|| materias
metodologias_materia }--|| metodologias_docentes
perfiles_profesor_curso }--|| profesores : perfil de
perfiles_profesor_curso }--|| cursos_academicos : del curso
ponderaciones_evaluacion }--|| guias : pesa en
ponderaciones_evaluacion }--|| sistemas_evaluacion : cuenta como
profesores }--o| universidades
referencias_bibliograficas }--|| guias : bibliografía de
resultados_aprendizaje }--|| programas : del plan de
sesiones }--|| guias : planificación docente de
sistemas_evaluacion }--|| materias : define

@enduml
