@startuml abrirGrados-diseño
title Diagrama de Secuencia - Abrir Grados

actor "DirectorGrado" as DirectorGrado
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "GradoRepository" as GradoRepo
database "Base de Datos" as DB

DirectorGrado -> Vista: solicita volver al listado de sus Grados
activate Vista
Vista -> API: GET /api/v1/grados
activate API
note right of API: el director_grado_id llega de la sesión\n(cookie JWT), no de la URL -- variante DirectorGrado\nde este CU compartido con Admin
API -> GradoRepo: listar_dirigidos_por(director_grado_id)
activate GradoRepo
GradoRepo -> DB: SELECT ... FROM grados g\nJOIN grados_directores_grado gd ON gd.grado_id = g.id\nWHERE gd.director_grado_id = :director_grado_id
activate DB
DB --> GradoRepo: filas Grado
deactivate DB
GradoRepo --> API: List[Grado]
deactivate GradoRepo

API --> Vista: 200 OK (List[GradoResponse] JSON)
deactivate API
Vista --> DirectorGrado: presenta el listado de Grados que dirige
deactivate Vista

@enduml

@startuml abrirGrados-admin-diseño
title Diagrama de Secuencia - Abrir Grados (variante Admin, anidado bajo Facultad)

actor "Admin" as Admin
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "GradoRepository" as GradoRepo
database "Base de Datos" as DB

Admin -> Vista: desde una Facultad abierta, solicita ver sus Grados
activate Vista
Vista -> API: GET /api/v1/admin/facultades/{facultad_id}/grados
activate API
note right of API: Depends(require_admin) -- la facultad_id llega de la\nURL (ruta anidada bajo Facultad), no de la sesión --\nvariante Admin de este CU compartido con DirectorGrado
API -> GradoRepo: listar_de_la_facultad(facultad_id)
activate GradoRepo
GradoRepo -> DB: SELECT ... FROM grados WHERE facultad_id = :facultad_id
activate DB
DB --> GradoRepo: filas Grado
deactivate DB
GradoRepo --> API: List[Grado]
deactivate GradoRepo

API --> Vista: 200 OK (List[GradoResponse] JSON, con facultad_id)
deactivate API
Vista --> Admin: presenta "GRADOS -- <FACULTAD>" con [Abrir]/[Eliminar] por fila
deactivate Vista

@enduml
