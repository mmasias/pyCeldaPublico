@startuml eliminarGrado-diseño
title Diagrama de Secuencia - Eliminar Grado

actor "Admin" as Admin
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "GradoRepository" as GradoRepo
participant "Grado" as Grado
database "Base de Datos" as DB

Admin -> Vista: solicita eliminar un Grado del listado de su Facultad
activate Vista
Vista --> Admin: presenta la información y pide confirmar/cancelar\n(sin comprobación previa de bloqueo -- no hay <<choice>>)

alt el Admin confirma
  Admin -> Vista: confirma
  Vista -> API: DELETE /api/v1/admin/grados/{grado_id}
  activate API
  note right of API: Depends(require_admin) -- ya disponible en\nbackend/app/core/auth.py (bloque anterior, ya mergeado)
  API -> GradoRepo: obtener(grado_id)
  activate GradoRepo
  GradoRepo -> DB: SELECT ... FROM grados WHERE id = :grado_id
  activate DB
  DB --> GradoRepo: fila Grado
  deactivate DB
  GradoRepo --> API: Grado (404 si None)
  deactivate GradoRepo
  API -> Grado: extinguir()
  activate Grado
  deactivate Grado
  API -> GradoRepo: actualizar(grado)
  activate GradoRepo
  GradoRepo -> DB: UPDATE grados SET estado = 'Extinguido' WHERE id = :grado_id
  activate DB
  DB --> GradoRepo: ok
  deactivate DB
  GradoRepo --> API: Grado
  deactivate GradoRepo
  API --> Vista: 200 OK (GradoResponse JSON, estado: "Extinguido")
  deactivate API
  Vista --> Admin: vuelve al listado anidado de la Facultad (Grado extinguido)
else el Admin cancela
  Admin -> Vista: cancela
  Vista --> Admin: cierra la confirmación, sin cambios -- sin llamada al backend
end
deactivate Vista

@enduml
