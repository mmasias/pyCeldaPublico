@startuml eliminarAsignaturaGrado-diseño
title Diagrama de Secuencia - Eliminar AsignaturaGrado

actor "Admin" as Admin
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "AsignaturaGradoRepository" as AsignaturaGradoRepo
participant "AsignaturaGrado" as AsignaturaGrado
database "Base de Datos" as DB

Admin -> Vista: solicita eliminar una AsignaturaGrado\nde la tabla embebida de la ficha del Grado
activate Vista
Vista --> Admin: presenta la información y pide confirmar/cancelar\n(sin comprobación previa de bloqueo -- no hay <<choice>>)

alt el Admin confirma
  Admin -> Vista: confirma
  Vista -> API: DELETE /api/v1/admin/asignaturas-grado/{asignatura_grado_id}
  activate API
  note right of API: Depends(require_admin) -- guard de Admin
  API -> AsignaturaGradoRepo: obtener(asignatura_grado_id)
  activate AsignaturaGradoRepo
  AsignaturaGradoRepo -> DB: SELECT ... FROM asignaturas_grado\nWHERE id = :asignatura_grado_id
  activate DB
  DB --> AsignaturaGradoRepo: fila AsignaturaGrado
  deactivate DB
  AsignaturaGradoRepo --> API: AsignaturaGrado (404 si None)
  deactivate AsignaturaGradoRepo
  API -> AsignaturaGrado: extinguir()
  activate AsignaturaGrado
  deactivate AsignaturaGrado
  API -> AsignaturaGradoRepo: actualizar(asignatura_grado)
  activate AsignaturaGradoRepo
  AsignaturaGradoRepo -> DB: UPDATE asignaturas_grado\nSET estado = 'Extinguido' WHERE id = :asignatura_grado_id
  activate DB
  DB --> AsignaturaGradoRepo: ok
  deactivate DB
  AsignaturaGradoRepo --> API: AsignaturaGrado
  deactivate AsignaturaGradoRepo
  API --> Vista: 200 OK (AsignaturaGradoResponse JSON, estado: "Extinguido")
  deactivate API
  Vista --> Admin: vuelve a la ficha del Grado (fila extinguida)
else el Admin cancela
  Admin -> Vista: cancela
  Vista --> Admin: cierra la confirmación, sin cambios -- sin llamada al backend
end
deactivate Vista

@enduml
