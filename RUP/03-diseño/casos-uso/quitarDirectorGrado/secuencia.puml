@startuml quitarDirectorGrado-diseño
title Diagrama de Secuencia - Quitar Director de Grado

actor "Admin" as Admin
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "ProfesorRepository" as ProfesorRepo
participant "DirectorGradoRepository" as DirectorRepo
participant "GradoRepository" as GradoRepo
database "Base de Datos" as DB

Admin -> Vista: pulsa [Quitar] en una fila de "Grados que dirige"
activate Vista
Vista -> API: DELETE /api/v1/profesores/{profesor_id}/directores-grado/{grado_id}
activate API
note right of API: Depends(require_admin) -- catálogo de Admin,\nsin pertenencia que verificar
API -> ProfesorRepo: obtener(profesor_id)
activate ProfesorRepo
ProfesorRepo -> DB: SELECT ... FROM profesores WHERE id = :profesor_id
activate DB
DB --> ProfesorRepo: fila Profesor (404 si None)
deactivate DB
ProfesorRepo --> API: Profesor
deactivate ProfesorRepo
API -> GradoRepo: obtener(grado_id)
activate GradoRepo
GradoRepo -> DB: SELECT ... FROM grados WHERE id = :grado_id
activate DB
DB --> GradoRepo: fila Grado (404 si None)
deactivate DB
GradoRepo --> API: Grado
deactivate GradoRepo
API -> DirectorRepo: obtener_por_email(profesor.email)
activate DirectorRepo
DirectorRepo -> DB: SELECT ... FROM directores_grado WHERE email = :email
activate DB
DB --> DirectorRepo: None / fila DirectorGrado
deactivate DB
DirectorRepo --> API: DirectorGrado | None
deactivate DirectorRepo
alt no dirige ese Grado (sin DirectorGrado o sin asociación)
  API --> Vista: 404 Not Found (detail: "Profesor no dirige ese Grado")
  deactivate API
  Vista --> Admin: presenta el error, sin cambios
else es el único DirectorGrado del Grado
  API -> GradoRepo: contar_directores(grado_id)
  activate GradoRepo
  GradoRepo -> DB: SELECT COUNT(*) FROM grados_directores_grado WHERE grado_id = :grado_id
  activate DB
  DB --> GradoRepo: 1
  deactivate DB
  GradoRepo --> API: 1
  deactivate GradoRepo
  API --> Vista: 409 Conflict (detail: "Profesor es el único director de este Grado")
  deactivate API
  Vista --> Admin: presenta el bloqueo con el detail tal cual, sin cambios
else queda al menos otro DirectorGrado
  API -> GradoRepo: contar_directores(grado_id)
  activate GradoRepo
  GradoRepo -> DB: SELECT COUNT(*) FROM grados_directores_grado WHERE grado_id = :grado_id
  activate DB
  DB --> GradoRepo: N > 1
  deactivate DB
  GradoRepo --> API: N
  deactivate GradoRepo
  API -> GradoRepo: grado.directores.remove(director) + commit
  activate GradoRepo
  GradoRepo -> DB: DELETE FROM grados_directores_grado\nWHERE grado_id = :grado_id AND director_grado_id = :director_id
  activate DB
  DB --> GradoRepo: ok
  deactivate DB
  GradoRepo --> API: void
  deactivate GradoRepo
  API --> Vista: 204 No Content
  deactivate API
  Vista -> API: GET /api/v1/profesores/{profesor_id} (refresca el detalle)
  API --> Vista: 200 OK (ProfesorDetalleResponse JSON -- Grado quitado)
  Vista --> Admin: presenta la sección actualizada
end
deactivate Vista

@enduml
