@startuml quitarDirectorPrograma-diseño
title Diagrama de Secuencia - Quitar Director de Programa

actor "Admin" as Admin
participant "Vista (React)" as Vista
participant "API (FastAPI)" as API
participant "ProfesorRepository" as ProfesorRepo
participant "DirectorProgramaRepository" as DirectorRepo
participant "ProgramaRepository" as ProgramaRepo
database "Base de Datos" as DB

Admin -> Vista: pulsa [Quitar] en una fila de "Programas que dirige"
activate Vista
Vista -> API: DELETE /api/v1/profesores/{profesor_id}/directores-programa/{programa_id}
activate API
note right of API: Depends(require_admin) -- catálogo de Admin,\nsin pertenencia que verificar
API -> ProfesorRepo: obtener(profesor_id)
activate ProfesorRepo
ProfesorRepo -> DB: SELECT ... FROM profesores WHERE id = :profesor_id
activate DB
DB --> ProfesorRepo: fila Profesor (404 si None)
deactivate DB
ProfesorRepo --> API: Profesor
deactivate ProfesorRepo
API -> ProgramaRepo: obtener(programa_id)
activate ProgramaRepo
ProgramaRepo -> DB: SELECT ... FROM programas WHERE id = :programa_id
activate DB
DB --> ProgramaRepo: fila Programa (404 si None)
deactivate DB
ProgramaRepo --> API: Programa
deactivate ProgramaRepo
API -> DirectorRepo: obtener_por_email(profesor.email)
activate DirectorRepo
DirectorRepo -> DB: SELECT ... FROM directores_programa WHERE email = :email
activate DB
DB --> DirectorRepo: None / fila DirectorPrograma
deactivate DB
DirectorRepo --> API: DirectorPrograma | None
deactivate DirectorRepo
alt no dirige ese Programa (sin DirectorPrograma o sin asociación)
  API --> Vista: 404 Not Found (detail: "Profesor no dirige ese Programa")
  deactivate API
  Vista --> Admin: presenta el error, sin cambios
else es el único DirectorPrograma del Programa
  API -> ProgramaRepo: contar_directores(programa_id)
  activate ProgramaRepo
  ProgramaRepo -> DB: SELECT COUNT(*) FROM programas_directores_programa WHERE programa_id = :programa_id
  activate DB
  DB --> ProgramaRepo: 1
  deactivate DB
  ProgramaRepo --> API: 1
  deactivate ProgramaRepo
  API --> Vista: 409 Conflict (detail: "Profesor es el único director de este Programa")
  deactivate API
  Vista --> Admin: presenta el bloqueo con el detail tal cual, sin cambios
else queda al menos otro DirectorPrograma
  API -> ProgramaRepo: contar_directores(programa_id)
  activate ProgramaRepo
  ProgramaRepo -> DB: SELECT COUNT(*) FROM programas_directores_programa WHERE programa_id = :programa_id
  activate DB
  DB --> ProgramaRepo: N > 1
  deactivate DB
  ProgramaRepo --> API: N
  deactivate ProgramaRepo
  API -> ProgramaRepo: programa.directores.remove(director) + commit
  activate ProgramaRepo
  ProgramaRepo -> DB: DELETE FROM programas_directores_programa\nWHERE programa_id = :programa_id AND director_programa_id = :director_id
  activate DB
  DB --> ProgramaRepo: ok
  deactivate DB
  ProgramaRepo --> API: void
  deactivate ProgramaRepo
  API --> Vista: 204 No Content
  deactivate API
  Vista -> API: GET /api/v1/profesores/{profesor_id} (refresca el detalle)
  API --> Vista: 200 OK (ProfesorDetalleResponse JSON -- Programa quitado)
  Vista --> Admin: presenta la sección actualizada
end
deactivate Vista

@enduml
