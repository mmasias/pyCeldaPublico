@startuml modeloDominio

hide empty members
hide circle

package "Estructura curricular" {
  class Universidad {
    nombre
  }
  class Facultad {
    nombre
  }
  class Grado {
    codigo
    nombre
    estado
  }
  class Materia {
    nombre
  }
  class SistemaEvaluacion {
    tipo
    descripcion
    ponderacionMinima
    ponderacionMaxima
  }
  class MetodologiaDocente {
    codigo
    descripcion
  }
  class MetodologiaMateria {
    descripcionPropia
  }
  class ActividadFormativa {
    codigo
    nombre
  }
  class ActividadFormativaMateria {
    horas
  }
  class ActividadFormativaAsignaturaGrado {
    horas
    porcentajePresencialidad
  }
  class Asignatura {
    codigo
    nombre
    ects
    contenido
    estado
  }
  class AsignaturaGrado {
    nombre
    curso
    caracter
    idioma
    ects
    semestreDefault
    contenido
    requisitosPrevios
    sesionesMinimas
    estado
  }

  class ResultadoAprendizaje {
    codigo
    tipo
    descripcion
  }

  class Requisito {
    tipo
  }
  class CursoAcademico {
    inicio
    fin
    estado
    semestreActivo
  }
  Universidad *-d- Facultad
  Facultad *-d- Grado
  Grado *-- Materia
  Materia *-- AsignaturaGrado
  Materia *-- SistemaEvaluacion
  Materia o-- MetodologiaDocente
  (Materia, MetodologiaDocente) .. MetodologiaMateria
  Universidad *-- MetodologiaDocente
  Universidad *-- ActividadFormativa
  Materia o-- ActividadFormativa
  (Materia, ActividadFormativa) .. ActividadFormativaMateria
  AsignaturaGrado o-- ActividadFormativa
  (AsignaturaGrado, ActividadFormativa) .. ActividadFormativaAsignaturaGrado
  (Grado, Asignatura) .. AsignaturaGrado
  Grado *-d- ResultadoAprendizaje
  Materia o-u- ResultadoAprendizaje
  AsignaturaGrado o- ResultadoAprendizaje
  AsignaturaGrado o-r- MetodologiaDocente
  AsignaturaGrado --> AsignaturaGrado : <sub>requiere</sub>
  AsignaturaGrado -[hidden]r- Requisito
  (AsignaturaGrado, AsignaturaGrado) .. Requisito
  Universidad -- CursoAcademico
}

package "Guía docente" {
  class Guia {
    semestre
    contenido
    estado
    sesionesMinimas
    fechaCreacion
    fechaUltimaModificacion
    fechaGeneracionPDF
  }
  class HistorialCambio {
    campo
    valorAnterior
    valorNuevo
    fecha
    comentario
  }

  class PonderacionEvaluacion {
    descripcion
    ponderacion
    vinculada
  }

  (AsignaturaGrado, CursoAcademico) .. Guia
  Guia *- HistorialCambio
  Guia *-d- PonderacionEvaluacion
  PonderacionEvaluacion -> SistemaEvaluacion

  class ReferenciaBibliografica {
    tipo
    referencia
    vinculada
  }

  Guia *-- ReferenciaBibliografica

  class PlanificacionDocente
  class Sesion {
    numero
    tipo
    descripcion
    vinculada
  }

  Guia *-- PlanificacionDocente
  PlanificacionDocente *-- Sesion
}

package "Personas y roles" {
  class Actor
  class Profesor {
    nombre
    email
  }
  class Admin {
    email
  }
  class DirectorGrado
  class PerfilProfesorCurso {
    validado
    orcid
    esDoctor
    universidadDoctorado
    anioDoctorado
    programaDoctorado
    mencionInternacional
    nivelAcreditacionSiiu
    organismoAcreditador
    organismoAcreditadorOtro
    numSexenios
    anioUltimoSexenio
    tramitandoSexenio
    numQuinquenios
    anioUltimoQuinquenio
    biografia
    aniosExperienciaDocente
    aniosExperienciaDocenteVirtual
    aniosExperienciaProfesional
    aniosExperienciaInvestigadora
    enlaceCvn
    enlaceFoto
    enlaceScholar
  }

  Profesor -u-|> Actor
  Admin -u-|> Actor
  DirectorGrado -u-|> Profesor
  Actor -> HistorialCambio
  Universidad -- Profesor
  AsignaturaGrado - Profesor
  Grado o- DirectorGrado
  (Profesor, CursoAcademico) .. PerfilProfesorCurso
}

Guia -- Profesor

@enduml
