@startuml abrirCursosAcademicos-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":SISTEMA_DISPONIBLE" as SistemaDisponible
rectangle #CDEBA5 ":CURSO_ACADEMICO_ABIERTO" as CursoAcademicoAbierto
rectangle #CDEBA5 ":CURSOS_ACADEMICOS_ABIERTO" as CursosAcademicosAbiertoSalida

package abrirCursosAcademicos as "abrirCursosAcademicos()" {
    rectangle #629EF9 AbrirCursosAcademicosView
    rectangle #b5bd68 CursoAcademicoController
    rectangle #F2AC4E CursoAcademico
    rectangle #F2AC4E CursoAcademicoRepository
}

SistemaDisponible --> AbrirCursosAcademicosView: <font size=8>abrirCursosAcademicos()

CursoAcademicoAbierto --> AbrirCursosAcademicosView: <font size=8>abrirCursosAcademicos()

AbrirCursosAcademicosView --> CursoAcademicoController: <font size=8>listarCursosAcademicosDeLaUniversidad(universidadId) : List<CursoAcademico>

CursoAcademicoController --> CursoAcademicoRepository: <font size=8>listarDeLaUniversidad(universidadId) : List<CursoAcademico>

CursoAcademicoController --> CursoAcademicoRepository: <font size=8>esElegibleParaActivar(cursoAcademicoId) : boolean [por fila, decide [Activar]]

CursoAcademicoController --> CursoAcademico: <font size=8>tieneGuiaAsociada() : boolean [por fila, dato para editarCursoAcademico()]

CursoAcademicoRepository -- CursoAcademico

AbrirCursosAcademicosView --> CursosAcademicosAbiertoSalida: <font size=8>presenta listado (fila: [Abrir]; solo si es elegible: [Activar])

@enduml
