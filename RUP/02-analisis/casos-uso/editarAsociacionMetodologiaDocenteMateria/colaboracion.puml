@startuml editarAsociacionMetodologiaDocenteMateria-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":MATERIA_ABIERTO" as MateriaAbierto
rectangle #CDEBA5 ":MATERIA_ABIERTO" as MateriaAbiertoSalida

package editarAsociacionMetodologiaDocenteMateria as "editarAsociacionMetodologiaDocenteMateria()" {
    rectangle #629EF9 EditarAsociacionMetodologiaDocenteMateriaView
    rectangle #b5bd68 MateriaController
    rectangle #F2AC4E MetodologiaMateria
    rectangle #F2AC4E MetodologiaMateriaRepository
}

MateriaAbierto --> EditarAsociacionMetodologiaDocenteMateriaView: <font size=8>editarAsociacionMetodologiaDocenteMateria(materiaId, metodologiaDocenteId)

EditarAsociacionMetodologiaDocenteMateriaView --> MateriaController: <font size=8>cargarAsociacion(materiaId, metodologiaDocenteId) : MetodologiaMateria

MateriaController --> MetodologiaMateriaRepository: <font size=8>obtener(materiaId, metodologiaDocenteId) : MetodologiaMateria

EditarAsociacionMetodologiaDocenteMateriaView --> MateriaController: <font size=8>guardarDescripcionPropia(materiaId, metodologiaDocenteId, descripcionPropia) : MetodologiaMateria

MateriaController --> MetodologiaMateria: <font size=8>actualizar(descripcionPropia)

MateriaController --> MetodologiaMateriaRepository: <font size=8>actualizar(metodologiaMateria)

MetodologiaMateriaRepository -- MetodologiaMateria

EditarAsociacionMetodologiaDocenteMateriaView --> MateriaAbiertoSalida: <font size=8>descripcionPropia actualizada

@enduml
