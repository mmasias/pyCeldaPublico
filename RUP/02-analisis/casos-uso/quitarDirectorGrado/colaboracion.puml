@startuml quitarDirectorGrado-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":PROFESOR_ABIERTO" as ProfesorAbierto
rectangle #CDEBA5 ":PROFESOR_ABIERTO" as ProfesorAbiertoSalida

package quitarDirectorGrado as "quitarDirectorGrado()" {
    rectangle #629EF9 QuitarDirectorGradoView
    rectangle #b5bd68 ProfesorController
    rectangle #F2AC4E Profesor
    rectangle #F2AC4E ProfesorRepository
    rectangle #F2AC4E Grado
    rectangle #F2AC4E GradoRepository
    rectangle #F2AC4E DirectorGrado
    rectangle #F2AC4E DirectorGradoRepository
}

ProfesorAbierto --> QuitarDirectorGradoView: <font size=8>quitarDirectorGrado(profesorId, gradoId)

QuitarDirectorGradoView --> ProfesorController: <font size=8>esUnicoDirectorDelGrado(profesorId, gradoId) : boolean

ProfesorController --> ProfesorRepository: <font size=8>obtener(profesorId) : Profesor

ProfesorController --> DirectorGradoRepository: <font size=8>obtenerPorEmail(email) : DirectorGrado

ProfesorController --> GradoRepository: <font size=8>dirige(gradoId, directorGradoId) : boolean

ProfesorController --> GradoRepository: <font size=8>contarDirectores(gradoId) : int

QuitarDirectorGradoView --> ProfesorController: <font size=8>quitarDirectorGrado(profesorId, gradoId)

ProfesorController --> Grado: <font size=8>directores.remove(director)

ProfesorRepository -- Profesor
DirectorGradoRepository -- DirectorGrado
GradoRepository -- Grado
DirectorGrado -- Grado
DirectorGrado -- Profesor: <font size=8>rol resuelto por email

QuitarDirectorGradoView ..[#green]> ProfesorAbiertoSalida: <font size=8>rol quitado, lista actualizada
QuitarDirectorGradoView ..[#red]> ProfesorAbiertoSalida: <font size=8>bloqueado, sin cambios -- único DirectorGrado del Grado
QuitarDirectorGradoView ..[#blue]> ProfesorAbiertoSalida: <font size=8>cancelado, sin cambios

@enduml
