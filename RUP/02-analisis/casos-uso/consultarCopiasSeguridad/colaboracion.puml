@startuml consultarCopiasSeguridad-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":SISTEMA_DISPONIBLE" as SistemaDisponible
rectangle #CDEBA5 ":COPIAS_SEGURIDAD_ABIERTO" as CopiasSeguridadAbiertoSalida

package consultarCopiasSeguridad as "consultarCopiasSeguridad()" {
    rectangle #629EF9 ConsultarCopiasSeguridadView
    rectangle #b5bd68 CopiaSeguridadController
    rectangle #F2AC4E ManifiestoCopiasSeguridad
}

SistemaDisponible --> ConsultarCopiasSeguridadView: <font size=8>consultarCopiasSeguridad()

ConsultarCopiasSeguridadView --> CopiaSeguridadController: <font size=8>listarCopiasSeguridad() : List<CopiaSeguridad>

CopiaSeguridadController --> ManifiestoCopiasSeguridad: <font size=8>leerCopias() : List<CopiaSeguridad>
note right: fichero plano, no entidad del dominio:\nausente o vacio = lista vacia; linea mal formada = se salta;\nlee del fichero real: disponible y esquemaVersion

ConsultarCopiasSeguridadView --> CopiasSeguridadAbiertoSalida: <font size=8>presenta listado (mas reciente primero), restaurables por defecto, o estado vacio

@enduml
