@startuml abrirGrado-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":GRADOS_ABIERTO" as GradosAbierto
rectangle #CDEBA5 ":GRADO_ABIERTO" as GradoAbiertoSalida

package abrirGrado as "abrirGrado()" {
    rectangle #629EF9 AbrirGradoView
    rectangle #b5bd68 GradoController
    rectangle #F2AC4E Grado
    rectangle #F2AC4E GradoRepository
    rectangle #F2AC4E Guia
    rectangle #F2AC4E GuiaRepository
}

GradosAbierto --> AbrirGradoView: <font size=8>abrirGrado(gradoId)

AbrirGradoView --> GradoController: <font size=8>cargarGrado(gradoId) : Grado

GradoController --> GradoRepository: <font size=8>obtener(gradoId) : Grado

AbrirGradoView --> GradoController: <font size=8>listarGuiasDelGrado(gradoId) : List<Guia>

GradoController --> GuiaRepository: <font size=8>listarDelGrado(gradoId) : List<Guia>

GradoRepository -- Grado
GuiaRepository -- Guia

AbrirGradoView --> GradoAbiertoSalida: <font size=8>muestra datos del Grado y el listado de Guia (retoque 2026-09-05, antes AsignaturaGrado)

@enduml

@startuml abrirGrado-admin-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":GRADOS_ABIERTO" as GradosAbierto
rectangle #CDEBA5 ":GRADO_ABIERTO" as GradoAbiertoSalida

package abrirGradoAdmin as "abrirGrado() -- Admin" {
    rectangle #629EF9 AbrirGradoView
    rectangle #b5bd68 GradoController
    rectangle #F2AC4E Grado
    rectangle #F2AC4E GradoRepository
    rectangle #F2AC4E AsignaturaGrado
    rectangle #F2AC4E AsignaturaGradoRepository
}

GradosAbierto --> AbrirGradoView: <font size=8>abrirGrado(gradoId)

AbrirGradoView --> GradoController: <font size=8>cargarGrado(gradoId) : Grado

GradoController --> GradoRepository: <font size=8>obtener(gradoId) : Grado

AbrirGradoView --> GradoController: <font size=8>listarAsignaturasGrado(gradoId) : List<AsignaturaGrado>

GradoController --> AsignaturaGradoRepository: <font size=8>listarDelGrado(gradoId) : List<AsignaturaGrado>

GradoRepository -- Grado
AsignaturaGradoRepository -- AsignaturaGrado

AbrirGradoView --> GradoAbiertoSalida: <font size=8>muestra datos del Grado, enlace a Materias y tabla de AsignaturaGrado con [Crear]/[Eliminar]

@enduml
