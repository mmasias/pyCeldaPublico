@startuml abrirActividadesFormativas-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":PROGRAMA_ABIERTO" as ProgramaAbierto
rectangle #CDEBA5 ":ACTIVIDADES_FORMATIVAS_ABIERTO" as ActividadesFormativasAbiertoSalida

package abrirActividadesFormativas as "abrirActividadesFormativas()" {
    rectangle #629EF9 AbrirActividadesFormativasView
    rectangle #b5bd68 ActividadFormativaController
    rectangle #F2AC4E ActividadFormativa
    rectangle #F2AC4E ActividadFormativaRepository
}

ProgramaAbierto --> AbrirActividadesFormativasView: <font size=8>abrirActividadesFormativas(programaId)

AbrirActividadesFormativasView --> ActividadFormativaController: <font size=8>listarActividadesFormativasDelPrograma(programaId) : List<ActividadFormativa>

ActividadFormativaController --> ActividadFormativaRepository: <font size=8>listarDelPrograma(programaId) : List<ActividadFormativa>

ActividadFormativaRepository -- ActividadFormativa

AbrirActividadesFormativasView --> ActividadesFormativasAbiertoSalida: <font size=8>presenta catálogo de ActividadFormativa del Programa

@enduml
