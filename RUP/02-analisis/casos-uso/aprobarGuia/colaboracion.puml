@startuml aprobarGuia-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":GUIA_ABIERTO" as GuiaAbierto
rectangle #CDEBA5 ":GUIAS_DEL_GRADO_ABIERTO" as GuiasDelGradoAbierto

package aprobarGuia as "aprobarGuia()" {
    rectangle #629EF9 AprobarGuiaView
    rectangle #b5bd68 GuiaController
    rectangle #F2AC4E Guia
    rectangle #F2AC4E HistorialCambio
    rectangle #F2AC4E GuiaRepository
}

GuiaAbierto --> AprobarGuiaView: <font size=8>aprobarGuia()

AprobarGuiaView --> GuiaController: <font size=8>aprobarGuia() : Guia

GuiaController --> Guia: <font size=8>aprobar() : boolean

GuiaController --> HistorialCambio: <font size=8>registrar("estado", "EnRevision", "Aprobada", "aprobada sin incidencia") : HistorialCambio

GuiaController --> GuiaRepository: <font size=8>actualizar(guia) : Guia

Guia -- HistorialCambio
GuiaRepository -- Guia

AprobarGuiaView ..[#green]> GuiasDelGradoAbierto: <font size=8>Guia aprobada

@enduml
