@startuml crearMateria-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":MATERIAS_ABIERTO" as MateriasAbierto
rectangle #CDEBA5 ":Collaboration EditarMateria" as EditarMateria

package crearMateria as "crearMateria()" {
    rectangle #629EF9 CrearMateriaView
    rectangle #b5bd68 MateriaController
    rectangle #F2AC4E Materia
    rectangle #F2AC4E MateriaRepository
}

MateriasAbierto --> CrearMateriaView: <font size=8>crearMateria()

CrearMateriaView --> MateriaController: <font size=8>validarDatosObligatorios(nombre) : boolean

CrearMateriaView --> MateriaController: <font size=8>crearMateria(nombre) : Materia

MateriaController --> MateriaRepository: <font size=8>crear(nombre, programaId) : Materia

MateriaRepository -- Materia

CrearMateriaView ..> EditarMateria:<font size=8> <<include>> editarMateria()

@enduml
