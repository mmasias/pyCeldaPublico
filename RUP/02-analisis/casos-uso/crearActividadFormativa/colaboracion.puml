@startuml crearActividadFormativa-analisis
skinparam linetype polyline

left to right direction

rectangle #CDEBA5 ":ACTIVIDADES_FORMATIVAS_ABIERTO" as ActividadesFormativasAbierto
rectangle #CDEBA5 ":ACTIVIDAD_FORMATIVA_ABIERTO" as ActividadFormativaAbiertoSalida

package crearActividadFormativa as "crearActividadFormativa()" {
    rectangle #629EF9 CrearActividadFormativaView
    rectangle #b5bd68 ActividadFormativaController
    rectangle #F2AC4E ActividadFormativa
    rectangle #F2AC4E ActividadFormativaRepository
}

ActividadesFormativasAbierto --> CrearActividadFormativaView: <font size=8>crearActividadFormativa(programaId)

CrearActividadFormativaView --> ActividadFormativaController: <font size=8>crearActividadFormativa(programaId, codigo, nombre) : ActividadFormativa

ActividadFormativaController --> ActividadFormativaRepository: <font size=8>codigoEnUso(programaId, codigo) : boolean

ActividadFormativaController --> ActividadFormativaRepository: <font size=8>crear(programaId, codigo, nombre) : ActividadFormativa

ActividadFormativaRepository -- ActividadFormativa

CrearActividadFormativaView ..[#green]> ActividadFormativaAbiertoSalida: <font size=8>ActividadFormativa creada
CrearActividadFormativaView ..[#red]> CrearActividadFormativaView: <font size=8>código repetido, formulario con lo escrito

@enduml
